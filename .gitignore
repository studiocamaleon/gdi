# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/apps/api/.venv-opennest/
/apps/api/.native/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/apps/marketing/.next/
/out/

# production
/build

# NestJS API build artifacts (never commit compiled output)
/apps/api/dist/
/apps/forma-studio/dist/
/apps/marketing/public/grafo3d/

# Storage local de archivos (driver de dev, sin R2). Son archivos de los
# tenants: nunca al repo.
/apps/api/.storage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …salvo las plantillas, que documentan las claves necesarias sin valores.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!/apps/marketing/next-env.d.ts

# local sqlite scratch db
dev.db

# local runtime artifacts / scratch
.tmp/
/tmp/
/output/
/outputs/
/apps/forma-studio/output/
/apps/forma-studio/tmp/
.claude/
apps/api/output.lp
apps/api/*.lp
backups/
apps/api/scripts/*.baseline.json

# Cache del lector CAD de Python
__pycache__/
*.pyc
