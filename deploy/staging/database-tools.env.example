# Sólo operador de migraciones. Nunca importar en API/workers.
DEPLOY_DATABASE_NAME=grafoprint_staging
MIGRATE_DATABASE_URL=postgresql://MIGRADOR:REEMPLAZAR@HOST_DIRECTO_NEON/grafoprint_staging?sslmode=require&schema=public
APP_DATABASE_URL=postgresql://grafoprint_staging_app:REEMPLAZAR@HOST_DIRECTO_NEON/grafoprint_staging?sslmode=require&schema=public

# Para bootstrap, usar DATABASE_URL del rol de ejecución (sin privilegios DDL).
DATABASE_URL=postgresql://grafoprint_staging_app:REEMPLAZAR@HOST_DIRECTO_NEON/grafoprint_staging?sslmode=require&schema=public
BOOTSTRAP_ADMIN_EMAIL=REEMPLAZAR
BOOTSTRAP_ADMIN_NAME=REEMPLAZAR
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_POR_SECRETO_ALEATORIO
