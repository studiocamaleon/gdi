# Sólo para grafoprint-staging-web. Completar fuera de Git y cargar con --stage.
STAGING_ACCESS_USER=grafoprint
STAGING_ACCESS_PASSWORD=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_AL_MENOS_24_CARACTERES
# Debe coincidir con api-ingress.env; nunca usar NEXT_PUBLIC para este valor.
STAGING_WEB_API_TOKEN=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Monitoreo opcional. No activar en desarrollo local. DSN del proyecto correspondiente.
SENTRY_ENABLED=false
SENTRY_DSN=
# Versión inmutable; en Docker se recibe como build-arg GRAFO_RELEASE.
GRAFO_RELEASE=
