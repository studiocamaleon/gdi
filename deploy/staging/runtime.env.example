# Plantilla para API y workers en Fly. Copiar fuera de Git y completar.
# NO importar placeholders: generar claves distintas por entorno.
DATABASE_URL=postgresql://grafoprint_staging_app:REEMPLAZAR@HOST_POOLER_NEON/grafoprint_staging?sslmode=require&schema=public&connection_limit=5
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO
INTEGRACIONES_ENCRYPTION_KEY=REEMPLAZAR_POR_32_BYTES_EN_BASE64
REDIS_URL=rediss://USUARIO:REEMPLAZAR@HOST_REDIS:6379
R2_ACCOUNT_ID=REEMPLAZAR
R2_ACCESS_KEY_ID=REEMPLAZAR
R2_SECRET_ACCESS_KEY=REEMPLAZAR
R2_BUCKET=grafoprint-staging-files
# Endpoint específico que Cloudflare indique para la jurisdicción del bucket.
R2_ENDPOINT=https://REEMPLAZAR.us.r2.cloudflarestorage.com

# El valor exacto de TRUST_PROXY depende del recorrido público/BFF.
# Verificar IP real y suplantación antes de habilitar usuarios de prueba.
# No incluir aquí MIGRATE_DATABASE_URL ni APP_DATABASE_URL.
# Sin credenciales de Meta, WATI, correo, Paddle ni AFIP reales en el primer ensayo.
