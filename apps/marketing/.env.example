# Dominio público en Vercel, administrado en Donweb.
MARKETING_SITE_URL=https://grafoprint.com.ar
# Predeterminado: prelaunch. Sólo live habilita el SaaS y consulta su API.
# Cambiar este modo requiere una nueva compilación y despliegue.
MARKETING_LAUNCH_MODE=prelaunch
MARKETING_CONTACT_URL=mailto:soporte@grafoprint.com.ar

# Subdominios propuestos: confirmar cuando el sistema esté listo.
# No se necesitan en prelaunch.
# MARKETING_APP_URL=https://app.grafoprint.com.ar
# URL accesible desde Vercel, con prefijo /api. Sólo se consulta en servidor.
# MARKETING_API_URL=https://api.grafoprint.com.ar/api
# MARKETING_LOGIN_URL=https://app.grafoprint.com.ar/login
# MARKETING_SIGNUP_URL=https://app.grafoprint.com.ar/registro
# MARKETING_DEMO_URL=mailto:soporte@grafoprint.com.ar?subject=Demo%20de%20Grafoprint
