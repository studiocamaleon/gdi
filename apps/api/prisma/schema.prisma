/// Lease de ejecución para los jobs programados.
///
/// Los crons corren DENTRO del proceso del API (`ScheduleModule.forRoot()`),
/// así que con más de una instancia cada job se dispara una vez por instancia:
/// el barrido de acreditaciones acreditaría dos veces, y el alta de plantillas
/// de Wati quemaría el doble del cupo de 10 por hora que impone Meta. El guard
/// `corriendo` de cada scheduler sólo protege dentro de un proceso.
///
/// Es un lease y no un advisory lock de Postgres a propósito: el lock de
/// sesión no sobrevive al pool de Prisma, y el de transacción obligaría a
/// mantener una transacción abierta durante todo el job —minutos de I/O de red
/// en el caso de Wati— pinchando una conexión y bloqueando el vacuum.
///
/// `expiraEl` es lo que hace que una instancia que se murió a mitad del job no
/// deje el lock tomado para siempre.
model CronLock {
  /// Nombre del job. Igual al `name` del decorador @Cron.
  nombre    String   @id
  tomadoEl  DateTime
  /// Hasta cuándo vale. Pasada esta fecha, otra instancia lo puede tomar.
  expiraEl  DateTime
  /// Qué proceso lo tiene. Evita que una instancia libere un lease ajeno
  /// cuando el suyo ya venció y otro lo tomó.
  instancia String?
}

/// Configuración de las notificaciones por WhatsApp. Una fila por tenant.
///
/// La ventana horaria es propia y no reusa el calendario de producción a
/// propósito: ése es POR ESTACIÓN —una imprenta puede tener corte y laminado
/// con horarios distintos— y "¿a qué hora se le puede escribir a un cliente?"
/// es una sola pregunta por empresa.
model ConfiguracionNotificaciones {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @unique @db.Uuid
  /// Freno de mano: corta TODOS los envíos sin desconectar la integración ni
  /// perder los toggles. Cuando algo se dispara mal hay que poder frenarlo en
  /// un click, no razonando qué evento apagar.
  ///
  /// Arranca en `true` — es decir, PAUSADO. Conectar Wati y aprobar plantillas
  /// no puede ser lo mismo que empezar a escribirle a todos los clientes de la
  /// imprenta: eso tiene que ser un acto deliberado, con alguien mirando. El
  /// tenant lo enciende cuando está listo.
  pausado   Boolean @default(true)
  /// Cortesía: a qué hora es aceptable escribirle a alguien. Vale para TODOS
  /// los mensajes; lo que caiga afuera espera, porque un WhatsApp automático a
  /// las 23:40 se lee como spam.
  horaDesde String  @default("09:00")
  horaHasta String  @default("20:00")

  /// Días con el local abierto al público, ISO (1 = lunes … 7 = domingo).
  ///
  /// Es una pregunta DISTINTA de la de arriba, y por eso es un campo aparte:
  /// "tu orden está lista, pasá a retirarla" mandado un sábado que la imprenta
  /// produce pero no atiende hace que el cliente viaje al pedo. Sólo lo
  /// respetan los eventos marcados `requiereLocalAbierto` en el catálogo; un
  /// pago acreditado o una factura salen cualquier día dentro del horario.
  diasAtencion String @default("1,2,3,4,5")

  /// Cuántos días después de ENTREGADA se pide la reseña. Ni el mismo día
  /// —el cliente todavía no usó lo que encargó— ni dos semanas después,
  /// cuando ya se olvidó.
  resenaDiasDespues Int @default(3)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Qué eventos del catálogo están encendidos para este tenant.
///
/// Sólo se guardan los que el tenant TOCÓ: si no hay fila, vale el
/// `activoPorDefecto` del catálogo. Así, sumar un evento nuevo lo enciende
/// según lo que decidió Grafo sin tener que backfillear a nadie.
model NotificacionEvento {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  /// `EventoNotificacion` del catálogo (`orden_lista`, `pago_recibido`, …).
  evento   String
  activo   Boolean

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, evento])
}

/// Cola de envíos y registro de lo que salió (decisión D5).
///
/// Es una cola pobre —una tabla y el cron que ya existe— y es a propósito: el
/// checklist pedía BullMQ + Redis, que no hay, y montarlos para esto sería
/// desproporcionado. Esto sobrevive a un reinicio, es observable desde la UI y
/// los puntos de enganche no cambian el día que aparezca Redis.
///
/// El evento de negocio NUNCA falla por la notificación (D4): encolar es un
/// insert, y todo lo que puede salir mal —plantilla sin aprobar, teléfono
/// inválido, cliente sin consentimiento— se resuelve acá y queda registrado.
model NotificacionWhatsapp {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  evento   String
  /// 'pendiente' | 'enviando' | 'enviada' | 'fallida' | 'descartada'
  ///
  /// `enviando` es la RESERVA: el despachador pasa la fila a ese estado en un
  /// update condicional antes de llamar a Wati, y por eso dos procesos que
  /// compiten por la misma fila no la mandan dos veces.
  /// Ver docs/notificaciones-whatsapp-catalogo.md
  estado   String @default("pendiente")

  clienteId    String? @db.Uuid
  ordenId      String? @db.Uuid
  cotizacionId String? @db.Uuid

  /// Idempotencia. `evento:idDeLaEntidad` — el índice único con `tenantId` es
  /// lo que hace que reentrar a un estado no vuelva a notificar.
  ///
  /// Hace falta de verdad: reabrir un paso de una OT finalizada la devuelve a
  /// producción (ordenes-trabajo.service.ts), y con la mesa de trabajo eso es
  /// operación normal. Sin esto, "tu orden está lista" sale dos veces.
  claveUnica String

  /// E.164 resuelto al encolar, no al enviar: si el cliente cambia el teléfono
  /// después, el mensaje sale al que estaba vigente cuando pasó el hecho.
  telefono   String
  plantilla  String
  parametros Json

  intentos Int     @default(0)
  /// Por qué se descartó o falló. Es lo que se muestra en el log.
  motivo   String?

  /// Cuándo se puede mandar. Fuera de la ventana horaria se corre al día
  /// siguiente en vez de descartarse.
  programadaPara DateTime?
  /// Cuándo se reservó para enviar. Si un proceso muere con la fila en
  /// `enviando`, esto es lo que permite soltarla en vez de dejarla colgada.
  reservadaEl    DateTime?
  enviadaEl      DateTime?
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, claveUnica])
  @@index([tenantId, estado, programadaPara])
  @@index([tenantId, createdAt])
}

