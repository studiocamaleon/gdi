  cobroImputaciones                                CobroImputacion[]
  comprobanteOrdenes                               ComprobanteOrden[]
  familiaPasoDefaults FamiliaPasoDefaults[]
  centroCopiadoConfig CentroCopiadoConfig?
}

/// Configuración del módulo Centro de copiado por tenant. Es CURACIÓN OPCIONAL:
/// un campo null = comportamiento por defecto (todos los papeles / todos los
/// tamaños producibles / Anillado). El tenant restringe/elige lo que ofrece el
/// TPV. La plantilla del motor se sigue reusando; esto sólo decide qué se
/// ofrece. Ver docs/centro-copiado-modulo-configurable-diseno.md.
model CentroCopiadoConfig {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @unique @db.Uuid
  /// El tenant puede pausar el módulo aunque el plan lo habilite.
  activo   Boolean @default(true)

  /// Cobrar la preparación/limpieza de máquina en cada documento. Default false:
  /// el centro de copiado no la cobra (volumen + precio por hoja claro). Si se
  /// activa, el motor deja de omitir setup/cleanup del paso de impresión.
  cobraSetup Boolean @default(false)

  /// Máquinas del centro (override de la auto-resolución por rol). Nullable:
  /// hoy default = auto-resuelto; se aplican en un incremento posterior.
  maquinaColorId String? @db.Uuid
  maquinaBnId    String? @db.Uuid
  /// Anilladora para la terminación "Anillado". null = la única ANILLADORA
  /// activa del tenant (si hay una sola). Sin anilladora, el anillado no se ofrece.
  maquinaAnilladoraId String? @db.Uuid
  /// Materia prima de la TAPA frontal (transparente) y la CONTRATAPA (plástica
  /// de color) del anillado. El tenant las elige en Configuración; el motor
  /// consume 1 de cada una por libro. null = auto (heurística por transparencia).
  /// El Wire-O no lleva tapas. Sólo A4/Oficio/A3 (se elige por tamaño del doc).
  tapaFrontalMateriaPrimaId    String? @db.Uuid
  tapaContratapaMateriaPrimaId String? @db.Uuid

  /// Papeles ofrecidos: [{ materiaPrimaId, gramajes?: number[] }]. null = todos.
  papelesJson       Json?
  /// Nombres de formato ofrecidos (del catálogo). null = todos los producibles.
  tamanosJson       Json?
  /// Terminaciones ofrecidas (nombres). null = ['Anillado'].
  terminacionesJson Json?
  /// Config de precio del producto plantilla (margen, etc.). null = default.
  precioConfigJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  email                   String                  @unique
  passwordHash            String?
  /// La clave que tiene es provisoria: la puso un administrador al
  /// restablecerla y el sistema obliga a cambiarla antes de dejar entrar a
  /// ningún lado. Así el admin puede devolverle el acceso a alguien sin quedar
  /// sabiendo con qué clave trabaja después.
  debeCambiarPassword     Boolean                 @default(false)
  nombreCompleto          String?
  activo                  Boolean                 @default(true)
  /// Rol en el control plane. Null = usuario común (la enorme mayoría).
  /// Se otorga por script/consola y todo cambio queda en PlataformaEvento.
  rolPlataforma           RolPlataforma?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  memberships             Membership[]
  authSessions            AuthSession[]
  plataformaEventos       PlataformaEvento[]      @relation("EventosDeStaff")
  invitations             Invitation[]
  empleados               Empleado[]
  ordenTrabajoEventos     OrdenTrabajoEvento[]
  archivosSubidos         Archivo[]               @relation("ArchivosSubidos")
  integracionesConectadas IntegracionTenant[]     @relation("IntegracionesConectadas")
  pasosEnMesa             OrdenTrabajoItemPaso[]  @relation("PasosEnMesa")
  pasosIniciados          OrdenTrabajoItemPaso[]  @relation("PasosIniciados")
  pasosCompletados        OrdenTrabajoItemPaso[]  @relation("PasosCompletados")
  tramosPaso              OrdenTrabajoPasoTramo[] @relation("TramosPaso")
  ahorrosConsolidacion    AhorroConsolidacion[]   @relation("AhorrosConsolidacion")
}

/// Quién le cambió el acceso a quién, dentro de una empresa.
///
/// Es el registro que faltaba del lado del tenant: `PlataformaEvento` audita al
/// staff de Grafo, no al administrador de la imprenta. Sin esto, "¿quién le dio
/// acceso a facturación al de depósito?" no tiene respuesta — y es exactamente
/// la pregunta que se hace cuando algo salió mal.
///
/// Append-only: no se edita ni se borra. Ver docs/usuarios-roles-permisos-diseno.md
model EventoAcceso {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  /// Quién lo hizo. Null si fue el sistema (seed, backfill, control plane).
  actorUserId           String?  @db.Uuid
  /// Se congela el nombre: si mañana el actor cambia de mail o se da de baja,
  /// la línea de auditoría tiene que seguir diciendo quién fue.
  actorNombre           String
  /// 'usuario_invitado' | 'rol_cambiado' | 'acceso_quitado' | 'acceso_devuelto'
  /// | 'invitacion_reenviada' | 'rol_creado' | 'rol_editado' | 'rol_eliminado'
  tipo                  String
  /// A quién le pasó, cuando aplica (los eventos de rol no tienen destinatario).
  usuarioAfectadoId     String?  @db.Uuid
  /// Congelado por lo mismo que `actorNombre`.
  usuarioAfectadoNombre String?
  /// La frase que se lee en el listado, ya armada.
  descripcion           String
  /// El detalle para el que quiera mirar fino: permisos antes y después, etc.
  datosJson             Json?
  createdAt             DateTime @default(now())
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Rol del tenant: un nombre y el conjunto de permisos que junta.
///
/// Los permisos son claves del catálogo de código (auth/permisos.ts), no filas:
/// se leen enteros cada vez que se evalúa uno, así que una tabla de N filas por
/// rol sería una junta más por request sin nada a cambio. Una clave retirada del
/// catálogo se ignora al expandir; con FKs habría que migrar.
///
/// Ver docs/usuarios-roles-permisos-diseno.md
model Rol {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  /// Clave estable de los predefinidos ('administrador', 'operario'…). Null en
  /// los que crea el tenant: ahí el nombre es lo único que los identifica.
  codigo       String?
  nombre       String
  descripcion  String?
  /// Predefinido de Grafo: se le editan los permisos, no se borra ni se
  /// renombra. Es también la plantilla que el tenant duplica.
  esDelSistema Boolean      @default(false)
  permisos     String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre])
}

model Membership {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  tenantId        String        @db.Uuid
  /// El rol del enum. Se mantiene mientras dure la transición a `rolId`: viaja
  /// en el JWT y lo leen los endpoints que todavía usan @Roles. Cuando todo
  /// pase por permisos, se retira.
  rol             RolSistema
  /// El rol de verdad. Null sólo en membresías que el backfill no alcanzó: ahí
  /// los permisos salen de `rol` (permisosDeRolBase).
  rolId           String?       @db.Uuid
  /// Desde qué IPs puede entrar esta persona A ESTA empresa. IP exacta o CIDR
  /// v4 ("190.1.2.3", "190.1.2.0/24").
  ///
  /// **Vacío = desde cualquier lado**, que es el default y el caso de casi
  /// todos. Que vacío signifique "cualquiera" y no "ninguna" es a propósito:
  /// si una migración dejara el campo en blanco, nadie queda encerrado afuera.
  ///
  /// Va en Membership y no en User porque es una política de la EMPRESA: la
  /// misma persona puede entrar sin restricción a una y sólo desde la oficina
  /// a otra. Ver docs/usuarios-roles-permisos-diseno.md
  ipsPermitidas   String[]      @default([])
  activa          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolDelTenant    Rol?          @relation(fields: [rolId], references: [id], onDelete: SetNull)
  authSessions    AuthSession[]
  invitationsSent Invitation[]  @relation("InvitationSender")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([rolId])
}

model AuthSession {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  /// Null en sesiones de PLATAFORMA (backoffice): el staff no está parado en
  /// ningún tenant. Toda sesión de tenant (normal o impersonación) lo lleva.
  currentTenantId     String?              @db.Uuid
  /// Null en sesiones de plataforma y de impersonación: el staff no tiene
  /// membership en el tenant. Toda sesión normal lo lleva.
  currentMembershipId String?              @db.Uuid
  /// Presente = esta sesión ES una impersonación del control plane. El guard
  /// resuelve el rol y el actor desde SesionImpersonacion, no desde membership.
  impersonacionId     String?              @unique @db.Uuid
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTenant       Tenant?              @relation(fields: [currentTenantId], references: [id], onDelete: Cascade)
  currentMembership   Membership?          @relation(fields: [currentMembershipId], references: [id], onDelete: Cascade)
  impersonacion       SesionImpersonacion? @relation(fields: [impersonacionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([currentTenantId])
}

model Invitation {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @db.Uuid
  userId                String?     @db.Uuid
  empleadoId            String?     @db.Uuid
  /// Null = invitación emitida desde el CONTROL PLANE (alta de tenant): el
  /// staff no tiene membership. Las de tenant siempre lo llevan.
  invitedByMembershipId String?     @db.Uuid
  email                 String
  rol                   RolSistema
  /// El rol del tenant con el que se invitó. Null en invitaciones viejas y en
  /// las del control plane, que sólo conocen el enum.
  rolId                 String?     @db.Uuid
  tokenHash             String      @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  empleado              Empleado?   @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  invitedByMembership   Membership? @relation("InvitationSender", fields: [invitedByMembershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([empleadoId])
}

model Cliente {
  /// Consentimiento para recibir WhatsApp. Arranca en false y NO se
  /// backfillea: WhatsApp exige opt-in y la ley 25.326 también, así que
  /// marcarlos a todos en true de una migración sería exactamente la trampa.
  aceptaWhatsapp      Boolean?
  /// Cuándo se registró el consentimiento. Sin esto no hay nada que mostrar
  /// el día que un cliente pregunte por qué le escriben.
  aceptaWhatsappEl    DateTime?
  id                  String                            @id @default(uuid()) @db.Uuid
  tenantId            String                            @db.Uuid
  nombre              String
  razonSocial         String?
  emailPrincipal      String
  telefonoCodigo      String
  telefonoNumero      String
  paisCodigo          String                            @db.VarChar(2)
  // === Datos fiscales (módulo Administración) ===
  /// CUIT/CUIL sin guiones (11 dígitos) o null si no lo tenemos todavía.
  cuit                String?                           @db.VarChar(11)
  /// 'RI' | 'monotributo' | 'exento' | 'consumidor_final' | 'exterior'.
  /// Define la letra del comprobante junto con la condición del emisor.
  condicionFiscal     String                            @default("consumidor_final")
  /// Tope de deuda en cta. cte. (null = sin límite definido).
  limiteCredito       Decimal?                          @db.Decimal(14, 2)
  /// Inhabilitado: sigue existiendo y sus órdenes, comprobantes y cobros
  /// quedan enteros, pero desaparece de las listas y de los buscadores.
  ///
  /// Es la única forma de "sacar" a un cliente que ya operó. Borrarlo dejaba
  /// las órdenes sin cliente EN SILENCIO: la relación es opcional, así que
  /// Postgres pone null y nadie se entera hasta que alguien busca de quién era
  /// una orden. Ver docs/clientes-inhabilitar-diseno.md
  activo              Boolean                           @default(true)
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  tenant              Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactos           ClienteContacto[]
  direcciones         ClienteDireccion[]
  // === Modelo Universal V2 ===
  cotizacionesV2      Cotizacion[]                      @relation("CotizacionV2Cliente")
  preciosEspecialesV2 ProductoPrecioEspecialClienteV2[] @relation("ProductoPrecioEspecialClienteV2Cliente")
  ordenesTrabajo      OrdenTrabajo[]                    @relation("OrdenTrabajoCliente")
  cobros              Cobro[]
  valores             Valor[]
  comprobantes        Comprobante[]
  archivos            Archivo[]

  @@unique([tenantId, nombre])
  @@index([tenantId, nombre])
  /// El listado sano esconde a los inhabilitados, así que filtra por activo
  /// en toda consulta.
  @@index([tenantId, activo])
}

