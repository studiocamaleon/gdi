/// La planilla del centro de costo: una línea por gasto, por persona o por
/// activo, toda cargada a mano y sin una sola clave foránea a Empleado o a
/// Maquina. Reemplaza a CentroCostoRecurso, CentroCostoRecursoMaquinaPeriodo y
/// CentroCostoComponenteCostoPeriodo, que se retiran en F7.
///
/// Ver docs/centros-de-costo-carga-manual-diseno.md
model CentroCostoLinea {
  id            String                          @id @default(uuid()) @db.Uuid
  tenantId      String                          @db.Uuid
  centroCostoId String                          @db.Uuid
  periodo       String
  seccion       SeccionCentroCostoLinea
  /// Texto libre en las tres secciones: el nombre de la persona, del gasto o
  /// del activo. Es a propósito que no apunte a ninguna entidad del sistema.
  nombre        String
  /// "Tipo de gasto" en los generales, "Tipo de activo fijo" en los activos.
  categoria     CategoriaComponenteCostoCentro?

  // Sólo EMPLEADO
  ocupacion      String?
  /// Qué parte de su tiempo le dedica esta persona al centro. Se guarda el
  /// porcentaje y no las horas porque es como lo piensa el usuario ("20% acá,
  /// 80% allá").
  ///
  /// ESCALA EL COSTO: el importe de la línea es sueldo × (1 + cargas) ×
  /// dedicación, así alguien repartido entre cuatro centros no se cuenta
  /// cuatro veces. Ausente significa 100%.
  ///
  /// Las horas productivas del centro tienen que declararse con el mismo
  /// criterio: si acá dice 75%, el centro sólo puede producir el 75% de las
  /// horas de esa persona. Cargar el 100% de las horas contra el 75% del
  /// costo abarata la tarifa sin que nadie lo note.
  dedicacionPct  Decimal? @db.Decimal(5, 2)
  salarioMensual Decimal? @db.Decimal(14, 2)
  /// Con 6 decimales aunque la UI muestre 2: con 2, cargas de $786,55 sobre un
  /// sueldo de $1.900 dan 41,3974% que se guardaría como 41,40 y reconstruiría
  /// $2.686,60 en vez de $2.686,55. Cinco centavos por línea que en la
  /// migración se leen como un centro que cambió de tarifa.
  cargasPct      Decimal? @db.Decimal(9, 6)

  // Sólo ACTIVO_FIJO
  vidaUtilRestanteMeses Int?
  valorActual           Decimal? @db.Decimal(14, 2)
  valorFinalVida        Decimal? @db.Decimal(14, 2)

  /// Calculado al guardar y persistido, redondeado a 2 decimales, para que la
  /// suma del centro no dependa de recorrer ramas por sección.
  importeMensual Decimal     @db.Decimal(14, 2)
  orden          Int         @default(0)
  notas          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centroCosto    CentroCosto @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@index([tenantId, centroCostoId, periodo])
  @@index([tenantId, periodo, seccion])
}

model CentroCostoCapacidadPeriodo {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @db.Uuid
  centroCostoId    String                @db.Uuid
  periodo          String
  /// El "PNH" del listado: las horas que el centro puede producir en el mes,
  /// cargadas a mano. Antes se derivaban de días × horas − % no productivo.
  horasProductivas Decimal               @db.Decimal(12, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centroCosto      CentroCosto           @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, centroCostoId, periodo])
}

model CentroCostoTarifaPeriodo {
  id                   String                         @id @default(uuid()) @db.Uuid
  tenantId             String                         @db.Uuid
  centroCostoId        String                         @db.Uuid
  periodo              String
  costoMensualTotal    Decimal                        @db.Decimal(12, 2)
  capacidadPractica    Decimal                        @db.Decimal(12, 2)
  tarifaCalculada      Decimal                        @db.Decimal(12, 2)
  /// Componente de mano de obra (SUELDOS + CARGAS) del centro, mensual y su
  /// tarifa horaria. Permite cobrar la hora hombre sólo sobre setup/cleanup y no
  /// sobre el runtime de la máquina. Ver docs/hora-hombre-setup-cleanup-diseno.md
  costoMensualManoObra Decimal                        @default(0) @db.Decimal(12, 2)
  tarifaManoObra       Decimal                        @default(0) @db.Decimal(12, 2)
  estado               EstadoTarifaCentroCostoPeriodo
  resumenJson          Json
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  tenant               Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centroCosto          CentroCosto                    @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, centroCostoId, periodo, estado])
  @@index([tenantId, centroCostoId, periodo])
