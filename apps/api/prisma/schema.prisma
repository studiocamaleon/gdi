model Maquina {
  id                           String                               @id @default(uuid()) @db.Uuid
  tenantId                     String                               @db.Uuid
  codigo                       String
  nombre                       String
  plantilla                    PlantillaMaquinaria
  plantillaVersion             Int                                  @default(1)
  fabricante                   String?
  modelo                       String?
  numeroSerie                  String?
  plantaId                     String                               @db.Uuid
  centroCostoPrincipalId       String?                              @db.Uuid
  /// Estación de trabajo donde vive la máquina (una sola). Independiente del
  /// centro de costo: costeo y piso de taller son ejes distintos.
  estacionId                   String?                              @db.Uuid
  estado                       EstadoMaquina                        @default(ACTIVA)
  estadoConfiguracion          EstadoConfiguracionMaquina           @default(BORRADOR)
  geometriaTrabajo             GeometriaTrabajoMaquina
  unidadProduccionPrincipal    UnidadProduccionMaquina
  anchoUtil                    Decimal?                             @db.Decimal(12, 2)
  largoUtil                    Decimal?                             @db.Decimal(12, 2)
  altoUtil                     Decimal?                             @db.Decimal(12, 2)
  espesorMaximo                Decimal?                             @db.Decimal(12, 2)
  pesoMaximo                   Decimal?                             @db.Decimal(12, 2)
  /// v3.0 (2026-04-26): columna universal agregada según doc §5
  /// (IMPRESORA_LASER) y §10 (PLOTTER_CAD). Para máquinas que no aplica,
  /// queda null.
  gramajeMaxGr                 Decimal?                             @db.Decimal(12, 2)
  fechaAlta                    DateTime?                            @db.Date
  activo                       Boolean                              @default(true)
  observaciones                String?
  parametrosTecnicosJson       Json?
  capacidadesAvanzadasJson     Json?
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  tenant                       Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planta                       Planta                               @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  centroCostoPrincipal         CentroCosto?                         @relation("MaquinaCentroCostoPrincipal", fields: [centroCostoPrincipalId], references: [id], onDelete: SetNull)
  estacion                     Estacion?                            @relation(fields: [estacionId], references: [id], onDelete: SetNull)
  perfilesOperativos           MaquinaPerfilOperativo[]
  consumibles                  MaquinaConsumible[]
  componentesDesgaste          MaquinaComponenteDesgaste[]
  // === Modelo Universal V2 ===
  productoConfigPasosM1        ProductoConfigPaso[]                 @relation("ProductoConfigPasoMaquinaM1")
  productoPasosExtrasM1        ProductoPasoExtra[]                  @relation("ProductoPasoExtraMaquinaM1")
  productoConfigPasoCandidatas ProductoConfigPasoMaquinaCandidata[] @relation("ProductoConfigPasoMaquinaCandidata")

  @@unique([tenantId, codigo])
  @@index([tenantId, plantilla, activo])
  @@index([tenantId, plantaId, activo])
  @@index([tenantId, estado])
  @@index([tenantId, centroCostoPrincipalId])
  @@index([tenantId, estacionId])
}

/// Perfil operativo de una máquina. Modelo universal alineado a doc §5–§13:
/// - Universales (columnas): productividad, setup, cleanup, feedReload, tipo.
/// - Discriminantes específicos por plantilla: en `detalleJson` (JSON libre).
///
/// v3.0 (2026-04-26): eliminadas 10 columnas legacy del modelo viejo
/// (printMode, printSides, cantidadPasadas, dobleFaz, materialPreset,
/// sheetThicknessMm, maxBatchHeightMm, operationMode, anchoAplicable,
/// altoAplicable). Ahora todas viven en `detalleJson` con las claves que la
/// plantilla declare.
model MaquinaPerfilOperativo {
  id                                  String                               @id @default(uuid()) @db.Uuid
  tenantId                            String                               @db.Uuid
  maquinaId                           String                               @db.Uuid
  nombre                              String
  tipoPerfil                          TipoPerfilOperativoMaquina
  activo                              Boolean                              @default(true)
  productivityValue                   Decimal?                             @db.Decimal(12, 2)
  productivityUnit                    UnidadProduccionMaquina?
  setupMin                            Decimal?                             @db.Decimal(12, 2)
  cleanupMin                          Decimal?                             @db.Decimal(12, 2)
  feedReloadMin                       Decimal?                             @db.Decimal(12, 2)
  /// Discriminantes y params específicos de la plantilla.
  /// Ej. IMPRESORA_LASER: { caras: 'SIMPLE_FAZ' | 'DOBLE_FAZ',
  ///   colores: 'BN' | 'CMYK', gramajeMinGr, gramajeMaxGr }
  /// Ej. GUILLOTINA: { gramajeMinGr, gramajeMaxGr, pliegosMaxPorTanda }
  /// Ej. PLOTTER_DE_CORTE: { tipoCorte: 'COMPLETO' | 'KISS_CUT',
  ///   modoOperacion: 'ROLLO' | 'HOJAS',
  ///   factorComplejidad: 'simple' | 'intermedio' | 'complejo' | 'personalizado' }
  detalleJson                         Json?
  /// Regla declarativa JsonLogic para auto-selección por el motor (G-M8).
  reglaSeleccionJson                  Json?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  tenant                              Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maquina                             Maquina                              @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  consumibles                         MaquinaConsumible[]
  // === Modelo Universal V2 ===
  productoConfigPasosM1               ProductoConfigPaso[]                 @relation("ProductoConfigPasoPerfilM1")
  productoPasosExtrasM1               ProductoPasoExtra[]                  @relation("ProductoPasoExtraPerfilM1")
  productoConfigPasoCandidatasDefault ProductoConfigPasoMaquinaCandidata[] @relation("ProductoConfigPasoMaquinaCandidataPerfilDefault")

  @@unique([tenantId, maquinaId, nombre])
  @@index([tenantId, maquinaId, activo])
}

model MaquinaConsumible {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  maquinaId              String                  @db.Uuid
  perfilOperativoId      String?                 @db.Uuid
  materiaPrimaVarianteId String                  @db.Uuid
  nombre                 String
  tipo                   TipoConsumibleMaquina
  unidad                 UnidadConsumoMaquina
  rendimientoEstimado    Decimal?                @db.Decimal(12, 2)
  consumoBase            Decimal?                @db.Decimal(12, 4)
  /// Consumo g/m² por nivel de cobertura: { borrador, normal, alta }. null =
  /// usar consumoBase (que equivale a la columna Normal). Ver
  /// docs/cobertura-toner-por-nivel-diseno.md
  consumoPorCoberturaJson Json?
  activo                 Boolean                 @default(true)
  detalleJson            Json?
  observaciones          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
