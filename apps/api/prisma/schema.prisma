  ubicacion         AlmacenMateriaPrimaUbicacion      @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)

  @@index([tenantId, varianteId, createdAt])
  @@index([tenantId, ubicacionId, createdAt])
  @@index([tenantId, tipo, createdAt])
  @@index([tenantId, referenciaTipo, referenciaId])
  @@index([tenantId, transferenciaId])
}

model ProductoImpuestoCatalogo {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  codigo             String
  nombre             String
  porcentaje         Float
  /// Base de cálculo del %: NETO (precio sin IVA) | BRUTO_COBRADO (total factura con
  /// impuestos por fuera incluidos, ej. impuesto al débito/crédito bancario).
  baseCalculo        String                     @default("NETO")
  /// POR_FUERA: se agrega al neto y se discrimina al cliente (IVA).
  /// POR_DENTRO: costo embebido en el neto vía gross-up (IIBB, imp. al cheque).
  traslado           String                     @default("POR_DENTRO")
  /// PRODUCTO: se asocia producto por producto (ej. IVA con alícuota según producto).
  /// TENANT: aplica a todas las cotizaciones del tenant sin asociación explícita
  /// (ej. IIBB, imp. al cheque — son de la empresa, no del producto).
  alcance            String                     @default("PRODUCTO")
  detalleJson        Json?
  activo             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productosAplicados ProductoImpuestoAplicado[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre, activo])
  @@index([tenantId, alcance, activo])
}

model ProductoComisionCatalogo {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  codigo             String
  nombre             String
  porcentaje         Float
  /// Base de cálculo del %: NETO (comisión de vendedor, sobre el precio sin IVA)
  /// | BRUTO_COBRADO (comisión de pasarela de pago/tarjeta, sobre lo cobrado con IVA).
  baseCalculo        String                     @default("NETO")
  detalleJson        Json?
  activo             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productosAplicados ProductoComisionAplicada[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre, activo])
}

/// Pivot Producto ⇄ ProductoImpuestoCatalogo. Reemplaza el embebido
/// `precioConfigJson.impuestos.esquemaId` para ganar integridad referencial,
/// unicidad por par (producto, impuesto), y queries reverse eficientes.
/// onDelete: Restrict en impuestoCatalogo evita borrar un esquema en uso —
/// el flujo correcto es marcarlo `activo: false` en el catálogo.
model ProductoImpuestoAplicado {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @db.Uuid
  productoId         String                   @db.Uuid
  impuestoCatalogoId String                   @db.Uuid
  /// Orden de aplicación si el cálculo es secuencial (default 0 = todos en paralelo).
  orden              Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto           Producto                 @relation(fields: [productoId], references: [id], onDelete: Cascade)
  impuestoCatalogo   ProductoImpuestoCatalogo @relation(fields: [impuestoCatalogoId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productoId, impuestoCatalogoId])
  @@index([tenantId, impuestoCatalogoId])
  @@index([tenantId, productoId])
}

/// Pivot Producto ⇄ ProductoComisionCatalogo. Mismas garantías que
/// ProductoImpuestoAplicado.
model ProductoComisionAplicada {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @db.Uuid
  productoId         String                   @db.Uuid
  comisionCatalogoId String                   @db.Uuid
  orden              Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto           Producto                 @relation(fields: [productoId], references: [id], onDelete: Cascade)
  comisionCatalogo   ProductoComisionCatalogo @relation(fields: [comisionCatalogoId], references: [id], onDelete: Restrict)

  @@unique([tenantId, productoId, comisionCatalogoId])
  @@index([tenantId, comisionCatalogoId])
  @@index([tenantId, productoId])
}

model Ruta {
  id                    String                    @id @default(uuid()) @db.Uuid
  tenantId              String                    @db.Uuid
  codigo                String
  nombre                String
  descripcion           String?
  versionActual         Int                       @default(1)
  activo                Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  tenant                Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasos                 RutaPaso[]
  versiones             RutaVersion[]
  productosAlternativas ProductoRutaAlternativa[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

model RutaPaso {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  rutaId          String               @db.Uuid
  version         Int                  @default(1)
  orden           Int
  /// Referencia a FamiliaCodigo de apps/api/src/productos-servicios/pasos/familias.ts (no FK por ser hardcoded en código).
  familiaCodigo   String
  /// Nombre de ícono visual para vistas de producción/tablero/kanban.
  icono           String               @default("Layout")
  activo          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruta            Ruta                 @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  productoConfigs ProductoConfigPaso[]

  @@unique([tenantId, rutaId, version, orden])
  @@index([tenantId, rutaId, version, activo])
}

model RutaVersion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  rutaId       String   @db.Uuid
  version      Int
  /// Snapshot completo de la ruta + sus pasos en esta versión.
  snapshotJson Json
  /// Descripción del cambio (modelador escribe).
  cambios      String?
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruta         Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)

  @@unique([tenantId, rutaId, version])
}

// === PRODUCTOS V2 ===

model ProductoCategoriaComercial {
  id            String                          @id @default(uuid()) @db.Uuid
  codigo        String                          @unique
  nombre        String
  descripcion   String?
  orden         Int                             @default(0)
  activo        Boolean                         @default(true)
  subcategorias ProductoSubcategoriaComercial[]
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@index([activo, orden])
}

model ProductoSubcategoriaComercial {
  id                  String                     @id @default(uuid()) @db.Uuid
  categoriaId         String                     @db.Uuid
  codigo              String                     @unique
  nombre              String
  descripcion         String?
  atributosSchemaJson Json
  orden               Int                        @default(0)
  activo              Boolean                    @default(true)
  categoria           ProductoCategoriaComercial @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  productos           Producto[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([categoriaId, codigo])
  @@index([categoriaId, activo, orden])
}

model Producto {
  id                        String                            @id @default(uuid()) @db.Uuid
  tenantId                  String                            @db.Uuid
  subcategoriaComercialId   String                            @db.Uuid
  codigo                    String
  nombre                    String
  descripcion               String?
  /// 'unidad' | 'm2' | 'metro_lineal'
  unidadComercial           String                            @default("unidad")
  modoMedidas               ModoMedidasProducto               @default(FIJA)
  minimoComercialPolitica   String                            @default("NONE")
  minimoComercialCantidad   Decimal?                          @db.Decimal(12, 4)
  minimoComercialBase       String                            @default("cantidad_comercial")
  medidaDefaultAnchoMm      Decimal?                          @db.Decimal(12, 2)
  medidaDefaultAltoMm       Decimal?                          @db.Decimal(12, 2)
  medidasPredefinidasJson   Json?
  /// Personalizaciones (áreas de decoración) con medida propia: cada una maneja
  /// el costo del film/paso de esa personalización, aparte de la medida base.
  /// Ver docs/personalizaciones-diseno.md
  personalizacionesJson     Json?
  /// Configuración del Tab Precio (preservado del modelo viejo).
  precioConfigJson          Json?
  atributosComercialesJson  Json?
  activo                    Boolean                           @default(true)
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  tenant                    Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategoriaComercial     ProductoSubcategoriaComercial     @relation(fields: [subcategoriaComercialId], references: [id], onDelete: Restrict)
  rutasAlternativas         ProductoRutaAlternativa[]
  pasosExtras               ProductoPasoExtra[]
  cargosDirectosCotizacion  ProductoCargoDirectoCotizacion[]
  preciosEspecialesClientes ProductoPrecioEspecialClienteV2[]
  impuestosAplicados        ProductoImpuestoAplicado[]
  comisionesAplicadas       ProductoComisionAplicada[]
  cotizacionItems           CotizacionItem[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@index([subcategoriaComercialId])
}

model ProductoRutaAlternativa {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @db.Uuid
  productoId             String               @db.Uuid
  rutaId                 String               @db.Uuid
  /// Versión específica de la ruta a la que apunta este producto.
  rutaVersion            Int
  /// Nombre humano de la alternativa (ej: "Vía láser", "Vía offset").
  nombre                 String
  esPreferida            Boolean              @default(false)
  /// JsonLogic opcional para auto-selección por motor según JobContext.
  reglaAutoSeleccionJson Json?
  orden                  Int                  @default(0)
  activo                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto               Producto             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ruta                   Ruta                 @relation(fields: [rutaId], references: [id])
  configPasos            ProductoConfigPaso[]
  pasosExtras            ProductoPasoExtra[]

  @@index([tenantId, productoId, activo])
  @@index([tenantId, productoId, rutaId])
  @@index([rutaId])
}

/// Configuración del producto para un paso específico de una ruta alternativa.
/// Es donde el producto "cierra" lo que la familia y la ruta dejan abierto:
/// modos, máquinas, materiales, cargos, paramsPaso.
model ProductoConfigPaso {
  id                          String                               @id @default(uuid()) @db.Uuid
  tenantId                    String                               @db.Uuid
  productoRutaAlternativaId   String                               @db.Uuid
  rutaPasoId                  String                               @db.Uuid
  /// 'OBLIGATORIO' | 'OPCIONAL' | 'CONDICIONAL' (cuando familia soporta varios).
  modoActivacion              String?
  condicionActivacionJson     Json?
  /// 'T-1' | 'T-2' | 'T-3' | 'T-4' (cuando familia soporta varios).
  modoTiempo                  String?
  /// 'DIRECT_FROM_JOBCONTEXT' | 'HEREDAR_DEL_OUTPUT_CANONICO' | 'CALCULADO_POR_PASO' | 'CONVERSION'.
  mecanismoCantidad           String?
  mecanismoCantidadConfigJson Json?
  /// Subset de los multiplicadoresSoportados de la familia que están activos.
  multiplicadoresActivos      String[]                             @default([])
  /// Params custom declarados por la familia (gap H19 de Fase E).
  paramsPasoJson              Json?
  /// Nombre operativo visible para propuesta/OT. La familia técnica sigue en RutaPaso.
  nombreVisible               String?
  maquinaM1Id                 String?                              @db.Uuid
  perfilM1Id                  String?                              @db.Uuid
  centroCostoId               String?                              @db.Uuid
  setupOverrideMin            Decimal?                             @db.Decimal(12, 2)
  cleanupOverrideMin          Decimal?                             @db.Decimal(12, 2)
  tiempoFijoOverrideMin       Decimal?                             @db.Decimal(12, 2)
  /// Cantidad de operarios que ocupa el paso. Multiplica SOLO el costo de mano
  /// de obra (no el de máquina): un paso a 2 personas consume el doble de
  /// horas-hombre. Ver docs/hora-hombre-setup-cleanup-diseno.md
  dotacionOperarios           Int                                  @default(1)
  activo                      Boolean                              @default(true)
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt
  tenant                      Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoRutaAlternativa     ProductoRutaAlternativa              @relation(fields: [productoRutaAlternativaId], references: [id], onDelete: Cascade)
  rutaPaso                    RutaPaso                             @relation(fields: [rutaPasoId], references: [id])
  maquinaM1                   Maquina?                             @relation("ProductoConfigPasoMaquinaM1", fields: [maquinaM1Id], references: [id])
  perfilM1                    MaquinaPerfilOperativo?              @relation("ProductoConfigPasoPerfilM1", fields: [perfilM1Id], references: [id])
  centroCosto                 CentroCosto?                         @relation("ProductoConfigPasoCentroCostoManual", fields: [centroCostoId], references: [id], onDelete: SetNull)
  slotsMateriales             ProductoConfigPasoSlotMaterial[]
  maquinasCandidatas          ProductoConfigPasoMaquinaCandidata[]
  cargosDirectosPaso          ProductoCargoDirectoPaso[]

  @@unique([tenantId, productoRutaAlternativaId, rutaPasoId])
  @@index([tenantId, productoRutaAlternativaId])
  @@index([tenantId, centroCostoId])
  @@index([tenantId, maquinaM1Id])
  @@index([tenantId, perfilM1Id])
}

model ProductoConfigPasoSlotMaterial {
  id                    String                                    @id @default(uuid()) @db.Uuid
  tenantId              String                                    @db.Uuid
  productoConfigPasoId  String                                    @db.Uuid
  /// Código del slot declarado por la familia (ej: 'sustrato_principal').
  slotCodigo            String
  /// Nombre visible editable para slots libres/adicionales.
  slotNombre            String?
  /// Rol semántico del material: SUSTRATO | COMPONENTE | CONSUMIBLE | PACKAGING.
  slotRol               String?
  /// 'HARDCODED' | 'COMERCIAL_ELIGE' | 'MOTOR_ELIGE_AUTO'.
  modoSeleccion         String
  /// 'MENOR_COSTO' | 'MAYOR_APROVECHAMIENTO' | 'MENOR_CAPACIDAD_QUE_CUMPLA'.
  criterioMotorAuto     String?
  criterioInputCampo    String?
  criterioMaterialCampo String?
  materialVarianteId    String?                                   @db.Uuid
  /// 'simple' | 'm2-exact' | 'consumed-length' | 'plate-segments'.
  estrategiaCosto       String                                    @default("simple")
  /// 'por_unidad_productiva' | 'por_m2' | 'por_pieza' | 'por_metro_lineal' | 'fijo'.
  formula               String                                    @default("por_unidad_productiva")
  /// Multiplicador de consumo para componentes/accesorios adicionales.
  cantidadFactor        Decimal?                                  @default(1) @db.Decimal(12, 4)
  /// Base operativa para aplicar cantidadFactor.
  cantidadBase          String?
  aplicaMultiCaras      Boolean                                   @default(false)
  activo                Boolean                                   @default(true)
  createdAt             DateTime                                  @default(now())
  updatedAt             DateTime                                  @updatedAt
  tenant                Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoConfigPaso    ProductoConfigPaso                        @relation(fields: [productoConfigPasoId], references: [id], onDelete: Cascade)
  materialVariante      MateriaPrimaVariante?                     @relation("ProductoConfigPasoSlotMaterialVariante", fields: [materialVarianteId], references: [id])
  candidatos            ProductoConfigPasoSlotMaterialCandidato[]

  @@unique([tenantId, productoConfigPasoId, slotCodigo])
  @@index([tenantId, productoConfigPasoId])
}

model ProductoConfigPasoSlotMaterialCandidato {
  id                String                                            @id @default(uuid()) @db.Uuid
  tenantId          String                                            @db.Uuid
  slotMaterialId    String                                            @db.Uuid
  materiaPrimaId    String                                            @db.Uuid
  defaultVarianteId String?                                           @db.Uuid
  orden             Int                                               @default(0)
  createdAt         DateTime                                          @default(now())
  updatedAt         DateTime                                          @updatedAt
  tenant            Tenant                                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotMaterial      ProductoConfigPasoSlotMaterial                    @relation(fields: [slotMaterialId], references: [id], onDelete: Cascade)
  materiaPrima      MateriaPrima                                      @relation(fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  defaultVariante   MateriaPrimaVariante?                             @relation("ProductoConfigPasoSlotMaterialCandidatoDefaultVariante", fields: [defaultVarianteId], references: [id], onDelete: SetNull)
  variantes         ProductoConfigPasoSlotMaterialCandidatoVariante[]

  @@unique([tenantId, slotMaterialId, materiaPrimaId])
  @@index([tenantId, slotMaterialId])
  @@index([tenantId, materiaPrimaId])
}

model ProductoConfigPasoSlotMaterialCandidatoVariante {
  id          String                                  @id @default(uuid()) @db.Uuid
  tenantId    String                                  @db.Uuid
  candidatoId String                                  @db.Uuid
  varianteId  String                                  @db.Uuid
  orden       Int                                     @default(0)
  createdAt   DateTime                                @default(now())
  tenant      Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidato   ProductoConfigPasoSlotMaterialCandidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  variante    MateriaPrimaVariante                    @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@unique([tenantId, candidatoId, varianteId])
  @@index([tenantId, candidatoId])
  @@index([tenantId, varianteId])
}

model ProductoConfigPasoMaquinaCandidata {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  productoConfigPasoId  String                  @db.Uuid
  maquinaId             String                  @db.Uuid
  perfilDefaultId       String?                 @db.Uuid
  modoColorAllowedModes String[]                @default([])
  esPreferida           Boolean                 @default(false)
  orden                 Int                     @default(0)
  activo                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoConfigPaso    ProductoConfigPaso      @relation(fields: [productoConfigPasoId], references: [id], onDelete: Cascade)
  maquina               Maquina                 @relation("ProductoConfigPasoMaquinaCandidata", fields: [maquinaId], references: [id])
  perfilDefault         MaquinaPerfilOperativo? @relation("ProductoConfigPasoMaquinaCandidataPerfilDefault", fields: [perfilDefaultId], references: [id])

  @@unique([tenantId, productoConfigPasoId, maquinaId])
  @@index([tenantId, productoConfigPasoId])
  @@index([tenantId, perfilDefaultId])
}

/// Pasos extras puntuales que un producto agrega a su ruta sin formar parte del esqueleto reusable.
/// Inline al producto (sub-tema 07 §4): no son reusables.
model ProductoPasoExtra {
  id                           String                   @id @default(uuid()) @db.Uuid
  tenantId                     String                   @db.Uuid
  productoId                   String                   @db.Uuid
  /// Ruta alternativa del producto a la que aplica el extra. El paso extra sólo
  /// afecta ESTA ruta de ESTE producto, nunca la ruta base reusable ni a otros
  /// productos. Nullable por compat con registros previos (backfill/limpieza).
  rutaAlternativaId            String?                  @db.Uuid
  /// null = al inicio del flujo. UUID = después de ese RutaPaso.
  insertarDespuesDeRutaPasoId  String?                  @db.Uuid
  ordenInterno                 Int                      @default(0)
  familiaCodigo                String
  /// Nombre visible del paso (mismo rol que en ProductoConfigPaso).
  nombreVisible                String?
  modoActivacion               String?
  condicionActivacionJson      Json?
  modoTiempo                   String?
  mecanismoCantidad            String?
  mecanismoCantidadConfigJson  Json?
  multiplicadoresActivos       String[]                 @default([])
  /// Overrides de tiempo (mismo rol que en ProductoConfigPaso).
  setupOverrideMin             Decimal?                 @db.Decimal(12, 2)
  cleanupOverrideMin           Decimal?                 @db.Decimal(12, 2)
  tiempoFijoOverrideMin        Decimal?                 @db.Decimal(12, 2)
  paramsPasoJson               Json?
  maquinaM1Id                  String?                  @db.Uuid
  perfilM1Id                   String?                  @db.Uuid
  /// Centro de costo para pasos manuales sin máquina (mismo rol que en
  /// ProductoConfigPaso). Con máquina, el centro sale del centroCostoPrincipal.
  centroCostoId                String?                  @db.Uuid
  /// Configuración inline (slots, candidatas, cargos) — embebido por simplicidad
  /// en pasos extras. Si crece mucho, migrar a tablas en el futuro.
  configSlotsMaterialesJson    Json?
  configMaquinasCandidatasJson Json?
  configCargosDirectosJson     Json?
  activo                       Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  tenant                       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto                     Producto                 @relation(fields: [productoId], references: [id], onDelete: Cascade)
  rutaAlternativa              ProductoRutaAlternativa? @relation(fields: [rutaAlternativaId], references: [id], onDelete: Cascade)
  maquinaM1                    Maquina?                 @relation("ProductoPasoExtraMaquinaM1", fields: [maquinaM1Id], references: [id])
  perfilM1                     MaquinaPerfilOperativo?  @relation("ProductoPasoExtraPerfilM1", fields: [perfilM1Id], references: [id])
  centroCosto                  CentroCosto?             @relation("ProductoPasoExtraCentroCostoManual", fields: [centroCostoId], references: [id], onDelete: SetNull)

  @@index([tenantId, productoId, activo])
  @@index([tenantId, rutaAlternativaId, activo])
}

// === CARGOS DIRECTOS (D.6) ===

model CargoDirectoCatalogo {
  id                        String                           @id @default(uuid()) @db.Uuid
  tenantId                  String                           @db.Uuid
  /// 'tercerizacion' | 'viatico' | 'combustible_flete' | 'matriz_custom' | 'recargo_urgencia'.
  codigo                    String
  nombre                    String
  descripcion               String?
  /// 'MONTO_FIJO_PLANO' | 'PORCENTAJE_SOBRE_BASE' | 'POR_UNIDAD_INPUT'.
  modoCalculo               String
  /// Lista de modos soportados: 'OBLIGATORIO' | 'OPCIONAL' | 'CONDICIONAL'.
  modosActivacionSoportados String[]                         @default([])
  /// Defaults por tipo (monto típico, base, etc.).
  configJson                Json?
  activo                    Boolean                          @default(true)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  tenant                    Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pasoCargos                ProductoCargoDirectoPaso[]
  cotizacionCargos          ProductoCargoDirectoCotizacion[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

model ProductoCargoDirectoPaso {
  id                      String               @id @default(uuid()) @db.Uuid
  tenantId                String               @db.Uuid
  productoConfigPasoId    String               @db.Uuid
  cargoDirectoCatalogoId  String               @db.Uuid
  modoActivacion          String
  condicionActivacionJson Json?
  configOverrideJson      Json?
  activo                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoConfigPaso      ProductoConfigPaso   @relation(fields: [productoConfigPasoId], references: [id], onDelete: Cascade)
  cargoDirectoCatalogo    CargoDirectoCatalogo @relation(fields: [cargoDirectoCatalogoId], references: [id])

  @@index([tenantId, productoConfigPasoId])
}

model ProductoCargoDirectoCotizacion {
  id                      String               @id @default(uuid()) @db.Uuid
  tenantId                String               @db.Uuid
  productoId              String               @db.Uuid
  cargoDirectoCatalogoId  String               @db.Uuid
  modoActivacion          String
  condicionActivacionJson Json?
  configOverrideJson      Json?
  activo                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto                Producto             @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cargoDirectoCatalogo    CargoDirectoCatalogo @relation(fields: [cargoDirectoCatalogoId], references: [id])

  @@index([tenantId, productoId])
}

// === COTIZACIONES V2 ===

model Cotizacion {
  id                           String           @id @default(uuid()) @db.Uuid
  tenantId                     String           @db.Uuid
  numero                       String?
  clienteId                    String?          @db.Uuid
  estado                       String           @default("borrador")
  fechaEmision                 DateTime?
  fechaValidez                 DateTime?
  observaciones                String?
  /// Cargos directos a nivel cotización (suma de los que apliquen).
  cargosDirectosCotizacionJson Json?
  subtotal                     Decimal?         @db.Decimal(14, 2)
  total                        Decimal?         @db.Decimal(14, 2)
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  tenant                       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                      Cliente?         @relation("CotizacionV2Cliente", fields: [clienteId], references: [id])
  items                        CotizacionItem[]
  ordenesTrabajo               OrdenTrabajo[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, clienteId])
}

model CotizacionItem {
  id                                String             @id @default(uuid()) @db.Uuid
  tenantId                          String             @db.Uuid
  cotizacionId                      String             @db.Uuid
  productoId                        String             @db.Uuid
  rutaAlternativaId                 String?            @db.Uuid
  cantidad                          Decimal            @db.Decimal(14, 2)
  /// Inputs del comercial al cotizar (ya normalizados).
  jobContextJson                    Json
  /// Snapshot completo: ruta + producto + materiales + valores + cargos (sub-tema 07 §7).
  snapshotJson                      Json
  costoUnitario                     Decimal?           @db.Decimal(14, 2)
  costoTotal                        Decimal?           @db.Decimal(14, 2)
  precioUnitario                    Decimal?           @db.Decimal(14, 2)
  precioTotal                       Decimal?           @db.Decimal(14, 2)
  /// Trazabilidad por bucket (a-g del molde).
  trazabilidadJson                  Json?
  /// === Snapshots inmutables del Tab Precio al momento de cotizar (Sprint 5.a) ===
  /// Si los catalogos del tenant cambian (porcentajes, esquemas inactivados),
  /// la cotización guarda lo que se aplicó realmente. Sin esto, recargar una
  /// cotización del pasado mostraría números distintos a los facturados.
  /// Forma esperada: { metodoCalculo, detalle } — copia de Producto.precioConfigJson.
  precioConfigSnapshotJson          Json?
  /// Forma esperada: [{ catalogoId, codigo, nombre, porcentaje, orden }]
  impuestosSnapshotJson             Json?
  /// Forma esperada: [{ catalogoId, codigo, nombre, porcentaje, orden }]
  comisionesSnapshotJson            Json?
  /// Si aplicó override por cliente: copia de ProductoPrecioEspecialClienteV2.configJson
  /// + metadata { precioEspecialId, clienteId, descripcion }. Null si se usó precio standard.
  precioEspecialClienteSnapshotJson Json?
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt
  tenant                            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cotizacion                        Cotizacion         @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto                          Producto           @relation(fields: [productoId], references: [id])
  ordenTrabajoItems                 OrdenTrabajoItem[]

  @@index([tenantId, cotizacionId])
  @@index([tenantId, productoId])
}

// === ÓRDENES DE TRABAJO ===
// La OT es una entidad distinta del presupuesto (Cotizacion): se emite al
// taller, progresa por estados y se entrega. El item referencia el snapshot
// completo vía cotizacionItemId y persiste sólo la proyección visible.
// Ver docs/ordenes-trabajo-persistencia-diseno.md

model OrdenTrabajo {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  /// "OT-2026-0184" — asignado al crear vía OrdenTrabajoContador.
  numero             String
  clienteId          String?              @db.Uuid
  vendedorEmpleadoId String?              @db.Uuid
  /// Presupuesto de origen (si vino del cotizador).
  cotizacionId       String?              @db.Uuid
  /// 'borrador' | 'pendiente' | 'produccion' | 'finalizada' | 'entregada'.
  estado             String               @default("borrador")
  fechaEmision       DateTime?
  fechaEntrega       DateTime?            @db.Date
  observaciones      String?
  /// 'mostrador' | 'web' | 'vendedor_externo' | 'telefono'.
  canalVenta         String?
  /// Denormalizados para el listado; la fuente de verdad es items/snapshot.
  subtotal           Decimal?             @db.Decimal(14, 2)
  impuestos          Decimal?             @db.Decimal(14, 2)
  cargosDirectos     Decimal?             @db.Decimal(14, 2)
  total              Decimal?             @db.Decimal(14, 2)
  /// Avance 0-100 informado por producción; null = sin dato.
  progresoPct        Int?
  /// Token aleatorio url-safe del link PÚBLICO de seguimiento del cliente
  /// (grafoprint.com.ar/track/<token>). Se genera al emitir la OT (salir de
  /// borrador); null = todavía no compartible. Ver docs/tracking-publico-diseno.md
  publicToken        String?              @unique
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente            Cliente?             @relation("OrdenTrabajoCliente", fields: [clienteId], references: [id])
  vendedor           Empleado?            @relation("OrdenTrabajoVendedor", fields: [vendedorEmpleadoId], references: [id])
  cotizacion         Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  items              OrdenTrabajoItem[]
  pasos              OrdenTrabajoItemPaso[]
  eventos            OrdenTrabajoEvento[]
  cobros             Cobro[]
  movimientosFondos  MovimientoFondos[]
  comprobantes       Comprobante[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, clienteId])
}

model OrdenTrabajoItem {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @db.Uuid
  ordenId               String          @db.Uuid
  /// FK al snapshot completo (ruta + pasos + materiales + valores). Las
  /// secciones futuras de Costos/Producción por item leen de ahí.
  /// Null = OT manual/histórica sin cotización.
  cotizacionItemId      String?         @db.Uuid
  codigo                String
  nombre                String
  /// Etiqueta corta legada (subcategoría). Preferir los dos campos de abajo.
  familia               String
  /// Categoría/subcategoría comercial tal como se ven al crear la orden
  /// ("Gran formato flexible" / "Vinilos impresos").
  categoriaComercial    String          @default("")
  subcategoriaComercial String          @default("")
  cantidad              Decimal         @db.Decimal(14, 2)
  cantidadUnidad        String
  subtotal              Decimal         @db.Decimal(14, 2)
  impuestos             Decimal         @db.Decimal(14, 2)
  total                 Decimal         @db.Decimal(14, 2)
  /// Proyección visible: [{ etiqueta, valor }].
  specsJson             Json?
  /// string[] de adicionales incluidos.
  adicionalesJson       Json?
  ordenIndice           Int             @default(0)
  createdAt             DateTime        @default(now())
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden                 OrdenTrabajo    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cotizacionItem        CotizacionItem? @relation(fields: [cotizacionItemId], references: [id])
  pasos                 OrdenTrabajoItemPaso[]

  @@index([tenantId, ordenId])
}

/// Paso de producción de un item de OT: la unidad de trabajo del Tablero.
/// Se materializa al EMITIR la orden desde `trazabilidadJson.pasos` del
/// snapshot del cotizador (sólo pasos activados). El snapshot sigue siendo
/// inmutable; acá vive el estado de EJECUCIÓN en el taller.
/// Ver docs/tablero-produccion-conexion-diseno.md
model OrdenTrabajoItemPaso {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  ordenId             String           @db.Uuid
  itemId              String           @db.Uuid
  /// Posición del paso en la ruta del item (orden topológico del snapshot).
  indice              Int
  /// rutaPasoId del PasoEjecutado de origen (trazar contra el snapshot).
  rutaPasoId          String?
  familiaCodigo       String
  /// Categoría de alto nivel de la familia (agrupa la vista Por estación).
  categoriaFamilia    String
  /// Nombre operativo visible ("Impresión digital frente").
  nombre              String
  /// Centro de costo que tarifó el paso — proxy de "estación" en fase 1.
  centroCostoId       String?          @db.Uuid
  centroCostoNombre   String?
  duracionEstimadaMin Decimal?         @db.Decimal(10, 2)
  /// 'pendiente' | 'en_curso' | 'hecho' | 'bloqueado'.
  estado              String           @default("pendiente")
  motivoBloqueo       String?
  iniciadoEl          DateTime?
  completadoEl        DateTime?
  /// Usuario que tomó el paso a SU mesa de trabajo (vista Por estación del
  /// tablero): reclamo visible para todos, persistente entre sesiones.
  mesaUsuarioId       String?          @db.Uuid
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden               OrdenTrabajo     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  item                OrdenTrabajoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mesaUsuario         User?            @relation("PasosEnMesa", fields: [mesaUsuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, ordenId])
  @@index([tenantId, itemId])
  @@index([tenantId, estado])
  @@index([tenantId, mesaUsuarioId])
}

model OrdenTrabajoEvento {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  ordenId       String       @db.Uuid
  fecha         DateTime     @default(now())
  /// 'emision' | 'numero_asignado' | 'borrador' | 'productos' | 'estado' |
  /// 'modificacion' | 'nota'.
  tipo          String
  descripcion   String
  /// Nombre visible del actor (snapshot; el FK real es usuarioId).
  usuarioNombre String
  /// FK real al usuario que ejecutó la acción; null para eventos de sistema.
  usuarioId     String?      @db.Uuid
  /// Diff estructurado para auditoría: { campo, antes, despues } u otros
  /// payloads según tipo. La descripción es el texto humano.
  datosJson     Json?
  /// 'usuario' | 'sistema' (a futuro: 'api').
  origen        String       @default("usuario")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden         OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario       User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, ordenId, fecha])
}

/// Contador atómico para numeración OT-AAAA-NNNN por tenant/año.
model OrdenTrabajoContador {
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anio])
}

// === ADMINISTRACIÓN (pagos / tesorería) ===
// Ver docs/modulo-administracion-diseno.md. Catálogos por tenant: cómo
// entra la plata (comisión, IVA s/comisión, plazo, retención) y dónde.

model CuentaFondos {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  /// 'caja' | 'banco' | 'billetera' | 'cartera_valores'.
  tipo               String
  nombre             String
  banco              String?
  cbuAlias           String?
  moneda             String             @default("ARS") @db.VarChar(3)
  /// Denormalizado recalculable desde MovimientoFondos (etapa B).
  saldo              Decimal            @default(0) @db.Decimal(14, 2)
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metodosPagoDefault MetodoPago[]
  movimientos        MovimientoFondos[]
  cobrosDestino      Cobro[]
  valoresDeposito    Valor[]

  @@unique([tenantId, nombre])
  @@index([tenantId, activo])
}

model MetodoPago {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @db.Uuid
  codigo                String
  nombre                String
  /// 'efectivo' | 'transferencia' | 'billetera_qr' | 'tarjeta_debito' |
  /// 'tarjeta_credito' | 'cheque_echeq' | 'debito_automatico'.
  tipo                  String
  comisionPct           Decimal       @default(0) @db.Decimal(6, 3)
  ivaComisionPct        Decimal       @default(0) @db.Decimal(6, 3)
  plazoAcreditacionDias Int           @default(0)
  /// Sugiere cargar líneas de retención al registrar cobros con este método.
  sufreRetencion        Boolean       @default(false)
  cuentaDestinoId       String?       @db.Uuid
  activo                Boolean       @default(true)
  orden                 Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaDestino         CuentaFondos? @relation(fields: [cuentaDestinoId], references: [id], onDelete: SetNull)
  cobros                Cobro[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

model MovimientoFondos {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  cuentaId           String        @db.Uuid
  fecha              DateTime      @default(now())
  /// 'entrada' | 'salida'.
  tipo               String
  monto              Decimal       @db.Decimal(14, 2)
  concepto           String
  /// 'cobro' | 'pago' | 'transferencia' | 'valor' | 'ajuste_arqueo'.
  origenTipo         String
  cobroId            String?       @db.Uuid
  valorId            String?       @db.Uuid
  /// Movimiento espejo en la otra cuenta (transferencias).
  transferenciaParId String?       @db.Uuid
  ordenId            String?       @db.Uuid
  /// Saldo de la cuenta después de este movimiento (extracto corrido).
  saldoPosterior     Decimal       @db.Decimal(14, 2)
  /// 'pendiente' | 'conciliado' | 'diferencia' (para conciliación, F3).
  estadoConciliacion String        @default("pendiente")
  createdAt          DateTime      @default(now())
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta             CuentaFondos  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  cobro              Cobro?        @relation(fields: [cobroId], references: [id])
  valor              Valor?        @relation(fields: [valorId], references: [id])
  orden              OrdenTrabajo? @relation(fields: [ordenId], references: [id])

  @@index([tenantId, cuentaId, fecha])
}

model Cobro {
  id                        String                @id @default(uuid()) @db.Uuid
  tenantId                  String                @db.Uuid
  clienteId                 String?               @db.Uuid
  ordenId                   String?               @db.Uuid
  fecha                     DateTime
  metodoPagoId              String                @db.Uuid
  cuentaDestinoId           String                @db.Uuid
  montoBruto                Decimal               @db.Decimal(14, 2)
  /// % de comisión efectivamente aplicado (editable sobre el del método).
  comisionPctAplicada       Decimal               @default(0) @db.Decimal(6, 3)
  comisionMonto             Decimal               @default(0) @db.Decimal(14, 2)
  comisionIvaMonto          Decimal               @default(0) @db.Decimal(14, 2)
  netoAcreditado            Decimal               @db.Decimal(14, 2)
  retencionesTotal          Decimal               @default(0) @db.Decimal(14, 2)
  disponibleReal            Decimal               @db.Decimal(14, 2)
  fechaAcreditacionEstimada DateTime?
  /// 'pendiente' | 'acreditado'. Los cheques acreditan vía su Valor.
  estadoAcreditacion        String                @default("pendiente")
  moneda                    String                @default("ARS") @db.VarChar(3)
  notas                     String?
  anuladoEl                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                   Cliente?              @relation(fields: [clienteId], references: [id])
  orden                     OrdenTrabajo?         @relation(fields: [ordenId], references: [id])
  metodoPago                MetodoPago            @relation(fields: [metodoPagoId], references: [id])
  cuentaDestino             CuentaFondos          @relation(fields: [cuentaDestinoId], references: [id])
  retenciones               RetencionPercepcion[]
  movimientos               MovimientoFondos[]
  valores                   Valor[]
  imputaciones              CobroImputacion[]

  @@index([tenantId, ordenId])
  @@index([tenantId, clienteId])
  @@index([tenantId, estadoAcreditacion])
}

model RetencionPercepcion {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  cobroId        String?  @db.Uuid
  /// 'sufrida' (nos retienen al cobrar) | 'practicada' (retenemos al pagar, F2).
  direccion      String   @default("sufrida")
  /// 'SIRCREB' | 'SIRTAC' | 'IIBB_CONVENIO' | 'SICORE_GANANCIAS' |
  /// 'IVA_RG2854' | 'PERCEPCION_IIBB' | 'otro'.
  regimen        String
  jurisdiccion   String?
  base           Decimal  @db.Decimal(14, 2)
  alicuota       Decimal  @db.Decimal(6, 3)
  monto          Decimal  @db.Decimal(14, 2)
  nroComprobante String?
  /// 'YYYY-MM' para el reporte del contador.
  periodoFiscal  String
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cobro          Cobro?   @relation(fields: [cobroId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodoFiscal])
  @@index([tenantId, regimen])
}

model Valor {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  /// 'tercero' (recibido) | 'propio' (emitido).
  origen           String
  /// 'fisico' | 'echeq'.
  formato          String
  /// 'comun' | 'diferido'.
  modalidad        String
  numero           String
  banco            String
  importe          Decimal            @db.Decimal(14, 2)
  moneda           String             @default("ARS") @db.VarChar(3)
  fechaEmision     DateTime?
  fechaPago        DateTime?
  /// tercero: 'cartera' | 'endosado' | 'depositado' | 'acreditado' | 'rechazado'
  /// propio:  'cartera' | 'debitado' | 'rechazado'.
  estado           String             @default("cartera")
  clienteId        String?            @db.Uuid
  proveedorId      String?            @db.Uuid
  cobroId          String?            @db.Uuid
  cuentaDepositoId String?            @db.Uuid
  motivoRechazo    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente          Cliente?           @relation(fields: [clienteId], references: [id])
  proveedor        Proveedor?         @relation(fields: [proveedorId], references: [id])
  cobro            Cobro?             @relation(fields: [cobroId], references: [id])
  cuentaDeposito   CuentaFondos?      @relation(fields: [cuentaDepositoId], references: [id])
  movimientos      MovimientoFondos[]

  @@index([tenantId, estado])
}

// === TAB PRECIO V2 ===
// Preserva la lógica del actual sistema de precios especiales por cliente
// adaptada al nuevo modelo de Producto.

model ProductoPrecioEspecialClienteV2 {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  productoId String   @db.Uuid
  clienteId  String   @db.Uuid
  /// Configuración del precio especial (mismo esquema que ProductoPrecioConfig del Tab Precio).
  configJson Json
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cliente    Cliente  @relation("ProductoPrecioEspecialClienteV2Cliente", fields: [clienteId], references: [id])

  @@unique([tenantId, productoId, clienteId])
  @@index([tenantId, clienteId])
}

// ═══════════════════════════════════════════════════════════════════════
// Administración · Configuración fiscal del emisor (etapa C)
// Ver docs/modulo-administracion-diseno.md
// ═══════════════════════════════════════════════════════════════════════

/// Datos fiscales del tenant como EMISOR. Junto con la condición del
/// receptor definen la letra del comprobante (ver letra-comprobante.ts).
/// Uno por tenant.
model ConfiguracionFiscal {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @unique @db.Uuid
  razonSocial          String
  /// CUIT del emisor, 11 dígitos sin guiones.
  cuit                 String       @db.VarChar(11)
  /// 'RI' | 'monotributo' | 'exento'. Un consumidor final no emite.
  condicionFiscal      String       @default("RI")
  /// Nº de inscripción en Ingresos Brutos (o convenio multilateral).
  ingresosBrutos       String?
  domicilioFiscal      String?
  inicioActividades    DateTime?
  /// Leyenda obligatoria en las facturas A cuando ARCA no reconoce
  /// solvencia patrimonial — reemplaza a la vieja factura M desde la
  /// RG 5762/2025: 'PAGO EN CBU INFORMADA' | 'OPERACIÓN SUJETA A RETENCIÓN'.
  leyendaFacturaA      String?
  /// 'manual' | 'tusfacturas'. Las credenciales del proveedor NO viven
  /// acá: se configuran en el módulo de Integraciones.
  proveedorFacturacion String       @default("manual")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntosVenta          PuntoVenta[]

  @@index([tenantId])
}

/// Punto de venta habilitado en ARCA. La numeración de comprobantes es
/// por (punto de venta, tipo, letra).
model PuntoVenta {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  configuracionFiscalId String              @db.Uuid
  /// Número que asignó ARCA (se muestra con 4 dígitos: 0001).
  numero                Int
  nombre                String
  /// 'web_services' (factura electrónica por API) | 'portal' (ARCA web) |
  /// 'talonario' (preimpreso). Sólo web_services puede emitir por provider.
  modalidad             String              @default("web_services")
  activo                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuracionFiscal   ConfiguracionFiscal @relation(fields: [configuracionFiscalId], references: [id], onDelete: Cascade)
  comprobantes          Comprobante[]
  contadores            ComprobanteContador[]

  @@unique([tenantId, numero])
  @@index([tenantId, activo])
}

// ═══════════════════════════════════════════════════════════════════════
// Administración · Comprobantes (etapa C2)
// ═══════════════════════════════════════════════════════════════════════

/// Comprobante fiscal (factura / NC / ND). La letra sale de la matriz
/// emisor×receptor (letra-comprobante.ts) y se congela al crear.
model Comprobante {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @db.Uuid
  /// 'factura' | 'nota_credito' | 'nota_debito'
  tipo                String
  /// 'A' | 'B' | 'C' | 'E'
  letra               String              @db.VarChar(1)
  puntoVentaId        String              @db.Uuid
  /// Número dentro de (punto de venta, tipo, letra). Null mientras es
  /// borrador: se asigna recién al emitir, con el contador atómico.
  numero              Int?
  fecha               DateTime            @db.Date
  clienteId           String?             @db.Uuid
  ordenId             String?             @db.Uuid
  /// Datos del receptor congelados al crear: si el cliente después cambia
  /// de CUIT o de condición, el comprobante emitido NO cambia.
  receptorSnapshot    Json
  /// [{ descripcion, cantidad, precioUnitarioSinIva, alicuotaIva, ... }]
  itemsJson           Json
  netoGravado         Decimal             @db.Decimal(14, 2)
  /// [{ alicuota, base, monto }] — la A las discrimina; B/C/E no.
  ivaPorAlicuota      Json
  ivaTotal            Decimal             @default(0) @db.Decimal(14, 2)
  total               Decimal             @db.Decimal(14, 2)
  moneda              String              @default("ARS")
  cotizacion          Decimal?            @db.Decimal(14, 4)
  /// 'borrador' | 'emitido' | 'rechazado' | 'anulado'
  estado              String              @default("borrador")
  cae                 String?
  caeVencimiento      DateTime?
  /// Condición de venta y vencimiento: el aging de deudores depende de esto.
  condicionVenta      String?
  vencimiento         DateTime?           @db.Date
  /// Leyenda RG 5762/2025 en las A ('PAGO EN CBU INFORMADA'…).
  leyenda             String?
  /// Errores de ARCA. Llegan como TEXTO LIBRE: no hay tabla pública de
  /// códigos, así que se guardan crudos para auditar.
  rechazoJson         Json?
  /// Respuesta cruda del provider (auditoría).
  providerRaw         Json?
  /// Clave anti-duplicado: se persiste ANTES de llamar al provider. Ante
  /// un timeout se consulta por ella, nunca se reintenta a ciegas —
  /// ningún provider garantiza idempotencia.
  idempotencyKey      String              @unique
  /// Saldo pendiente de cobro (total − imputaciones). Denormalizado, se
  /// mantiene en la misma transacción que las imputaciones.
  saldoPendiente      Decimal             @default(0) @db.Decimal(14, 2)
  /// Para NC/ND: el comprobante que corrigen.
  comprobanteOrigenId String?             @db.Uuid
  anuladoEl           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntoVenta          PuntoVenta          @relation(fields: [puntoVentaId], references: [id], onDelete: Restrict)
  cliente             Cliente?            @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  orden               OrdenTrabajo?       @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  comprobanteOrigen   Comprobante?        @relation("ComprobanteCorrige", fields: [comprobanteOrigenId], references: [id], onDelete: SetNull)
  correcciones        Comprobante[]       @relation("ComprobanteCorrige")
  imputaciones        CobroImputacion[]

  @@unique([tenantId, puntoVentaId, tipo, letra, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, ordenId])
  @@index([tenantId, vencimiento])
}

/// Numeración atómica por (punto de venta, tipo, letra) — mismo patrón que
/// OrdenTrabajoContador. ARCA exige numeración correlativa sin huecos.
model ComprobanteContador {
  tenantId     String     @db.Uuid
  puntoVentaId String     @db.Uuid
  tipo         String
  letra        String     @db.VarChar(1)
  ultimo       Int        @default(0)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntoVenta   PuntoVenta @relation(fields: [puntoVentaId], references: [id], onDelete: Cascade)

  @@id([tenantId, puntoVentaId, tipo, letra])
}

/// Aplica un cobro a un comprobante. Un cobro sin imputaciones es un
/// anticipo a cuenta; la suma de imputaciones nunca supera ni al cobro ni
/// al saldo del comprobante.
model CobroImputacion {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  cobroId       String      @db.Uuid
  comprobanteId String      @db.Uuid
  monto         Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cobro         Cobro       @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@unique([cobroId, comprobanteId])
  @@index([tenantId, comprobanteId])
}
