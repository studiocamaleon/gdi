  espesorMaximo                Decimal?                             @db.Decimal(12, 2)
  pesoMaximo                   Decimal?                             @db.Decimal(12, 2)
  /// v3.0 (2026-04-26): columna universal agregada según doc §5
  /// (IMPRESORA_LASER) y §10 (PLOTTER_CAD). Para máquinas que no aplica,
  /// queda null.
  gramajeMaxGr                 Decimal?                             @db.Decimal(12, 2)
