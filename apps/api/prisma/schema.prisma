// === COTIZACIONES V2 ===

model Cotizacion {
  id                           String             @id @default(uuid()) @db.Uuid
  tenantId                     String             @db.Uuid
  /// PRES-AAAA-NNNN (CotizacionContador). Null = contenedor de snapshots
  /// de la ficha (venta directa); con número = PRESUPUESTO formal.
  numero                       String?
  clienteId                    String?            @db.Uuid
  /// Ciclo del presupuesto (docs/presupuestos-modulo-estudio.md §4):
  /// 'borrador' | 'enviado' | 'aprobado' | 'rechazado' | 'vencido' |
  /// 'convertido' ('pendiente_aprobacion' reservado para F2).
  estado                       String             @default("borrador")
  fechaEmision                 DateTime?
  fechaValidez                 DateTime?
  observaciones                String?
  /// Cargos directos a nivel cotización (suma de los que apliquen).
  cargosDirectosCotizacionJson Json?
  subtotal                     Decimal?           @db.Decimal(14, 2)
  impuestos                    Decimal?           @db.Decimal(14, 2)
  total                        Decimal?           @db.Decimal(14, 2)
  /// === Ciclo comercial del presupuesto ===
  vendedorEmpleadoId           String?            @db.Uuid
  canalVenta                   String?
  fechaEnvio                   DateTime?
  fechaResuelto                DateTime?
  /// Picklist al perder: 'precio' | 'plazo' | 'sin_respuesta' |
  /// 'competencia' | 'otro' (+detalle libre).
  motivoPerdida                String?
  motivoPerdidaDetalle         String?            @db.VarChar(300)
  /// === Aprobación interna por umbrales (F2) ===
  /// Motivos que dispararon al intentar enviar: [{ regla, detalle }].
  aprobacionMotivosJson        Json?
  aprobacionSolicitadaEl       DateTime?
  aprobacionResueltaPorId      String?            @db.Uuid
  aprobacionResueltaPorNombre  String?
  aprobacionResueltaEl         DateTime?
  /// Credencial del link público "ver/aprobar presupuesto" (patrón tracking).
  publicToken                  String?            @unique
  /// Primera apertura del link público — el badge "visto" (no es estado).
  primeraVistaEl               DateTime?
  senaSugeridaPct              Decimal?           @db.Decimal(5, 2)
  /// Proyección congelada para convertir en OT sin reconstruir la ficha:
  /// { fechaEntrega, canalVenta, cargosDirectos, items: CrearOrdenTrabajoItemDto[] }.
  emisionJson                  Json?
  /// OT creada al convertir (referencia cruzada; la OT ya guarda cotizacionId).
  convertidaOrdenId            String?            @db.Uuid
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  tenant                       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                      Cliente?           @relation("CotizacionV2Cliente", fields: [clienteId], references: [id])
  vendedor                     Empleado?          @relation("CotizacionVendedor", fields: [vendedorEmpleadoId], references: [id], onDelete: SetNull)
  items                        CotizacionItem[]
  ordenesTrabajo               OrdenTrabajo[]
  eventos                      CotizacionEvento[]
  archivos                     Archivo[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, clienteId])
}

/// Numeración de presupuestos por tenant y año (patrón OrdenTrabajoContador).
model CotizacionContador {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, anio])
}

/// Timeline del presupuesto (patrón OrdenTrabajoEvento): creado, enviado,
/// visto, aprobado/rechazado (por el vendedor o por el CLIENTE vía link
/// público — con timestamp, vale como firma virtual), vencido, convertido.
model CotizacionEvento {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @db.Uuid
  cotizacionId  String     @db.Uuid
  fecha         DateTime   @default(now())
  tipo          String
  descripcion   String
  /// Null = acción del sistema o del cliente por link público.
  usuarioId     String?    @db.Uuid
  usuarioNombre String
  datosJson     Json?
  /// 'usuario' | 'sistema' | 'cliente'.
  origen        String     @default("usuario")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cotizacion    Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([tenantId, cotizacionId, fecha])
}

/// Configuración de presupuestos por tenant (patrón ConfiguracionProduccion).
/// Los campos de aprobación interna quedan dormidos hasta F2.
model ConfiguracionPresupuestos {
  id                          String   @id @default(uuid()) @db.Uuid
  tenantId                    String   @unique @db.Uuid
  validezDiasDefault          Int      @default(15)
  senaSugeridaPctDefault      Decimal  @default(50) @db.Decimal(5, 2)
  /// Términos y condiciones que imprime el PDF.
  condicionesTexto            String?
  aprobacionMontoMax          Decimal? @db.Decimal(14, 2)
  aprobacionMargenMinPct      Decimal? @db.Decimal(5, 2)
  aprobacionDescuentoMaxPct   Decimal? @db.Decimal(5, 2)
  requiereAprobacionSinCosteo Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CotizacionItem {
  id                                String             @id @default(uuid()) @db.Uuid
  tenantId                          String             @db.Uuid
  cotizacionId                      String             @db.Uuid
  productoId                        String             @db.Uuid
  rutaAlternativaId                 String?            @db.Uuid
  cantidad                          Decimal            @db.Decimal(14, 2)
  /// Inputs del comercial al cotizar (ya normalizados).
  jobContextJson                    Json
  /// Snapshot completo: ruta + producto + materiales + valores + cargos (sub-tema 07 §7).
  snapshotJson                      Json
  costoUnitario                     Decimal?           @db.Decimal(14, 2)
  costoTotal                        Decimal?           @db.Decimal(14, 2)
  precioUnitario                    Decimal?           @db.Decimal(14, 2)
  precioTotal                       Decimal?           @db.Decimal(14, 2)
  /// Descuento comercial de la línea (sobre el neto). El efecto ya está en
  /// precioUnitario/precioTotal y los snapshots; esto es la traza para editar.
  descuentoTipo                     String?
  descuentoValor                    Decimal?           @db.Decimal(14, 2)
  descuentoMonto                    Decimal?           @db.Decimal(14, 2)
  /// Trazabilidad por bucket (a-g del molde).
  trazabilidadJson                  Json?
  /// === Snapshots inmutables del Tab Precio al momento de cotizar (Sprint 5.a) ===
  /// Si los catalogos del tenant cambian (porcentajes, esquemas inactivados),
  /// la cotización guarda lo que se aplicó realmente. Sin esto, recargar una
  /// cotización del pasado mostraría números distintos a los facturados.
  /// Forma esperada: { metodoCalculo, detalle } — copia de Producto.precioConfigJson.
  precioConfigSnapshotJson          Json?
  /// Forma esperada: [{ catalogoId, codigo, nombre, porcentaje, orden }]
  impuestosSnapshotJson             Json?
  /// Forma esperada: [{ catalogoId, codigo, nombre, porcentaje, orden }]
  comisionesSnapshotJson            Json?
  /// Si aplicó override por cliente: copia de ProductoPrecioEspecialClienteV2.configJson
  /// + metadata { precioEspecialId, clienteId, descripcion }. Null si se usó precio standard.
  precioEspecialClienteSnapshotJson Json?
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt
  tenant                            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cotizacion                        Cotizacion         @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  producto                          Producto           @relation(fields: [productoId], references: [id])
  ordenTrabajoItems                 OrdenTrabajoItem[]

  @@index([tenantId, cotizacionId])
  @@index([tenantId, productoId])
}

// === ÓRDENES DE TRABAJO ===
// La OT es una entidad distinta del presupuesto (Cotizacion): se emite al
// taller, progresa por estados y se entrega. El item referencia el snapshot
// completo vía cotizacionItemId y persiste sólo la proyección visible.
// Ver docs/ordenes-trabajo-persistencia-diseno.md

model OrdenTrabajo {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @db.Uuid
  /// "OT-2026-0184" — asignado al crear vía OrdenTrabajoContador.
  numero                  String
  clienteId               String?                @db.Uuid
  vendedorEmpleadoId      String?                @db.Uuid
  /// Presupuesto de origen (si vino del cotizador).
  cotizacionId            String?                @db.Uuid
  /// 'borrador' | 'pendiente' | 'produccion' | 'finalizada' | 'entregada' |
  /// 'cancelada'. Las cinco primeras son una SECUENCIA que sólo avanza;
  /// 'cancelada' es una salida lateral y terminal.
  estado                  String                 @default("borrador")
  fechaEmision            DateTime?
  fechaEntrega            DateTime?              @db.Date
  observaciones           String?
  /// 'mostrador' | 'web' | 'vendedor_externo' | 'telefono'.
  canalVenta              String?
  /// Denormalizados para el listado; la fuente de verdad es items/snapshot.
  subtotal                Decimal?               @db.Decimal(14, 2)
  impuestos               Decimal?               @db.Decimal(14, 2)
  cargosDirectos          Decimal?               @db.Decimal(14, 2)
  /// Σ de los descuentos comerciales de los items (sobre el neto), denormalizado
  /// para el listado. El descuento ya está DENTRO de `subtotal`/`total`.
  descuentoTotal          Decimal?               @db.Decimal(14, 2)
  total                   Decimal?               @db.Decimal(14, 2)
  /// Avance 0-100 informado por producción; null = sin dato.
  progresoPct             Int?
  /// Token aleatorio url-safe del link PÚBLICO de seguimiento del cliente
  /// (grafoprint.com.ar/track/<token>). Se genera al emitir la OT (salir de
  /// borrador); null = todavía no compartible. Ver docs/tracking-publico-diseno.md
  publicToken             String?                @unique
  /// Primera vez que la orden llegó a 'finalizada'. Ancla del aging de la
  /// deuda COMERCIAL (la deuda nace acá, no en la factura). Reabrir la
  /// orden NO la borra: si vuelve a finalizar, el aging no se resetea.
  /// Ver docs/facturacion-ordenes-deuda-comercial-diseno.md
  fechaFinalizada         DateTime?
  /// Cuándo se entregó, la PRIMERA vez. Es el ancla del pedido de reseña —"N
  /// días después de la entrega"—, y por eso no se resetea: volver a marcar
  /// entregada una orden que se había reabierto no reinicia el reloj.
  ///
  /// Null en todas las órdenes anteriores a este campo, a propósito: sin fecha
  /// no hay pedido de reseña, y así encender la función no dispara un WhatsApp
  /// por cada orden vieja del historial.
  fechaEntregada          DateTime?
  /// Denormalizados del eje fiscal y de cobranza, mantenidos en la misma
  /// transacción que sus movimientos (patrón Comprobante.saldoPendiente):
  /// facturadoTotal = Σ ComprobanteOrden.monto de facturas emitidas no
  /// anuladas (las NC restan); cobradoTotal = Σ Cobro.montoBruto no
  /// anulados de la orden. Los estados derivados (sin facturar/parcial/
  /// facturada y sin cobrar/parcial/cobrada) se calculan de acá.
  facturadoTotal          Decimal                @default(0) @db.Decimal(14, 2)
  cobradoTotal            Decimal                @default(0) @db.Decimal(14, 2)
  /// === Cancelación ===
  /// Cuándo se canceló. Es el "está cancelada" real: `estado` lo dice también,
  /// pero esta fecha es la que ordena y la que permite contar cancelaciones
  /// por período sin adivinar mirando el timeline.
  canceladaEl             DateTime?
  /// En qué etapa estaba cuando se canceló. Sin esto se pierde la diferencia
  /// entre una que murió en borrador y una que se cortó con el taller a mitad
  /// de camino, que es justo lo que hay que poder mirar después.
  estadoAlCancelar        String?
  /// Por qué. Obligatorio al cancelar: una orden que desaparece de las ventas
  /// sin explicación es una discusión asegurada tres meses después.
  motivoCancelacion       String?
  canceladaPorId          String?                @db.Uuid
  /// Nombre CONGELADO de quien canceló: el legajo puede cambiar o borrarse y
  /// el historial no puede quedar sin responsable.
  canceladaPorNombre      String?
  /// Foto del avance al momento de cancelar: cuántos pasos estaban hechos
  /// sobre el total y cuántos minutos reales se habían trabajado. Es lo que
  /// permite decidir si se le cobra algo al cliente, y queda acá porque los
  /// pasos siguen vivos pero el avance se sigue moviendo si alguien reabre.
  pasosHechosAlCancelar   Int?
  pasosTotalAlCancelar    Int?
  minutosRealesAlCancelar Int?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                 Cliente?               @relation("OrdenTrabajoCliente", fields: [clienteId], references: [id])
  vendedor                Empleado?              @relation("OrdenTrabajoVendedor", fields: [vendedorEmpleadoId], references: [id])
  cotizacion              Cotizacion?            @relation(fields: [cotizacionId], references: [id])
  items                   OrdenTrabajoItem[]
  pasos                   OrdenTrabajoItemPaso[]
  eventos                 OrdenTrabajoEvento[]
  cobros                  Cobro[]
  movimientosFondos       MovimientoFondos[]
  comprobantes            Comprobante[]
  comprobanteOrdenes      ComprobanteOrden[]
  archivos                Archivo[]

  @@unique([tenantId, numero])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, clienteId])
}

model OrdenTrabajoItem {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @db.Uuid
  ordenId               String                 @db.Uuid
  /// FK al snapshot completo (ruta + pasos + materiales + valores). Las
  /// secciones futuras de Costos/Producción por item leen de ahí.
  /// Null = OT manual/histórica sin cotización.
  cotizacionItemId      String?                @db.Uuid
  codigo                String
  nombre                String
  /// Etiqueta corta legada (subcategoría). Preferir los dos campos de abajo.
  familia               String
  /// Categoría/subcategoría comercial tal como se ven al crear la orden
  /// ("Gran formato flexible" / "Vinilos impresos").
  categoriaComercial    String                 @default("")
  subcategoriaComercial String                 @default("")
  cantidad              Decimal                @db.Decimal(14, 2)
  cantidadUnidad        String
  subtotal              Decimal                @db.Decimal(14, 2)
  impuestos             Decimal                @db.Decimal(14, 2)
  total                 Decimal                @db.Decimal(14, 2)
  /// Descuento comercial de la línea (sobre el neto, antes del IVA). El efecto
  /// Cupón que originó el descuento (F4). Sin FK dura: el cupón puede
  /// borrarse del catálogo sin romper órdenes históricas.
  descuentoCuponId      String?                @db.Uuid
  /// YA está dentro de subtotal/impuestos/total; estos campos son la traza:
  /// tipo + valor ingresado + monto neto efectivamente descontado.
  descuentoTipo         String?
  descuentoValor        Decimal?               @db.Decimal(14, 2)
  descuentoMonto        Decimal?               @db.Decimal(14, 2)
  /// Proyección visible: [{ etiqueta, valor }].
  specsJson             Json?
  /// string[] de adicionales incluidos.
  adicionalesJson       Json?
  ordenIndice           Int                    @default(0)
  createdAt             DateTime               @default(now())
  /// ── Descomposición del ciclo real, calculada UNA vez al finalizar el
  /// item (docs/eta-metricas-historicas-diseno.md §4.4). null hasta el
  /// cierre; también null en items sin timestamps de pasos (OT vieja).
  cicloTotalMin         Int?
  trabajoRealMin        Int?
  esperaCicloMin        Int?
  trasladoMin           Int?
  proveedorMin          Int?
  /// trabajoRealMin / cicloTotalMin × 100 (0–100).
  flowEfficiencyPct     Decimal?               @db.Decimal(5, 1)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden                 OrdenTrabajo           @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cotizacionItem        CotizacionItem?        @relation(fields: [cotizacionItemId], references: [id])
  pasos                 OrdenTrabajoItemPaso[]
  etaPromesas           EtaPromesa[]
  archivos              Archivo[]

  @@index([tenantId, ordenId])
}

/// Promesa de ETA congelada en un hito de negocio
/// (docs/eta-metricas-historicas-diseno.md §4.1). Una fila por item por
/// hito; `finReal`/`errorMin` se completan al cerrar el item. La predicción
/// muere si no se captura en el momento — de acá salen todas las métricas de
/// precisión del pronóstico.
model EtaPromesa {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  ordenId      String           @db.Uuid
  itemId       String           @db.Uuid
  /// 'emision' | 'repromesa' | 'cotizacion' (F3).
  hito         String
  congeladaEl  DateTime         @default(now())
  /// null = el motor no pudo estimar (se guarda igual: mide la cobertura).
  finEstimado  DateTime?
  sinEstimar   Boolean          @default(false)
  parcial      Boolean          @default(false)
  /// Fecha de entrega comprometida al cliente EN ese momento (colchón).
  fechaEntrega DateTime?
  /// ── Se completan al cerrar el item ──
  finReal      DateTime?
  /// finReal − finEstimado en minutos CALENDARIO (+ = terminó tarde).
  errorMin     Int?
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item         OrdenTrabajoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, congeladaEl])
  @@index([tenantId, itemId])
}

/// Foto diaria de la cola proyectada por estación (F2, §4.2). Una fila por
/// tenant/fecha/estación; el cron la escribe con upsert (idempotente). De la
/// serie salen las colas históricas y el ranking de cuello de botella.
model EtaSnapshotEstacion {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  /// Fecha local del taller (DATE).
  fecha            DateTime @db.Date
  /// Id real de estación, o los buckets sintéticos sin-estacion/proveedor.
  estacionKey      String
  estacionNombre   String
  /// Cola de trabajo encolado (min).
  colaMin          Int
  /// Proyección de vaciado (jornadas; null = sin calendario).
  horizonteDias    Decimal? @db.Decimal(6, 1)
  esperaP50Min     Int
  esperaP90Min     Int
  /// Máximo de trabajos compitiendo por un puesto en el plan.
  contencionMax    Int
  /// Min programados próximos 5 días / capacidad × puestos.
  utilizacion5dPct Decimal  @db.Decimal(5, 1)
  pasosEnPlan      Int
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha, estacionKey])
  @@index([tenantId, estacionKey, fecha])
}

/// Foto diaria del ETA por item (F2, §4.3). La serie de `finEstimado` por item
/// es el DRIFT; `margenMin` vs la entrega alimenta la alerta temprana.
model EtaSnapshotItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  itemId      String    @db.Uuid
  fecha       DateTime  @db.Date
  finEstimado DateTime?
  sinEstimar  Boolean
  parcial     Boolean
  /// finEstimado − fechaEntrega (min; + = proyecta tarde). null sin entrega.
  margenMin   Int?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha, itemId])
  @@index([tenantId, itemId, fecha])
}

/// Paso de producción de un item de OT: la unidad de trabajo del Tablero.
/// Se materializa al EMITIR la orden desde `trazabilidadJson.pasos` del
/// snapshot del cotizador (sólo pasos activados). El snapshot sigue siendo
/// inmutable; acá vive el estado de EJECUCIÓN en el taller.
/// Ver docs/tablero-produccion-conexion-diseno.md
model OrdenTrabajoItemPaso {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenantId            String                  @db.Uuid
  ordenId             String                  @db.Uuid
  itemId              String                  @db.Uuid
  /// Posición del paso en la ruta del item (orden topológico del snapshot).
  indice              Int
  /// rutaPasoId del PasoEjecutado de origen (trazar contra el snapshot).
  rutaPasoId          String?
  familiaCodigo       String
  /// Categoría de alto nivel de la familia (agrupa la vista Por estación).
  categoriaFamilia    String
  /// Nombre operativo visible ("Impresión digital frente").
  nombre              String
  /// Centro de costo que tarifó el paso — proxy de "estación" en fase 1.
  centroCostoId       String?                 @db.Uuid
  centroCostoNombre   String?
  /// Máquina que ejecutó el paso (la que eligió el motor). Señal REAL para
  /// rutear a estaciones por máquina/tecnología, en vez del centro de costo
  /// (que es de costeo). Null en pasos sin máquina o en órdenes viejas.
  /// Ver docs/estaciones-reglas-diseno.md.
  maquinaId           String?                 @db.Uuid
  duracionEstimadaMin Decimal?                @db.Decimal(10, 2)
  /// 'pendiente' | 'en_curso' | 'pausado' | 'hecho' | 'bloqueado'.
  estado              String                  @default("pendiente")
  motivoBloqueo       String?
  /// === Tercerización (F2, docs/productos-tercerizados-diseno.md §6) ===
  /// 'interno' (producción propia, va al tablero) | 'tercerizado' (compra a un
  /// proveedor, va al panel de Compras, fuera del tablero).
  tipoEjecucion       String                  @default("interno")
  proveedorId         String?                 @db.Uuid
  /// Snapshot del nombre del proveedor (no FK, patrón de los demás nombres).
  proveedorNombre     String?
  plazoProveedorDias  Int?
  /// Sólo tercerizados: 'pendiente' | 'pedido' | 'recibido' | 'entregado'.
  /// Al llegar a recibido/entregado, `estado` pasa a 'hecho' (desbloquea el
  /// paso interno siguiente y cuenta en el progreso de la OT).
  estadoCompra        String?
  iniciadoEl          DateTime?
  completadoEl        DateTime?
  /// Cómo se registra el trabajo (snapshot del catálogo de familias al
  /// materializar, D1): 'cronometro' (MO domina, tramos) | 'solo_completar'
  /// (runtime de máquina, un click y tiempo = estimado).
  modoRegistro        String                  @default("cronometro")
  /// Tiempo real asentado al completar (D3). En modo cronómetro es la suma
  /// de tramos; en solo_completar copia el estimado. Null hasta 'hecho'.
  tiempoRealMin       Decimal?                @db.Decimal(10, 2)
  /// Calidad/origen de tiempoRealMin: 'medido' | 'medido_lote' |
  /// 'declarado' | 'estimado' | 'invalido'.
  tiempoFuente        String?
  /// Atribución directa (D5): quién abrió el primer tramo / quién completó.
  /// Nombre = snapshot (el FK puede quedar null si se borra el usuario).
  iniciadoPorId       String?                 @db.Uuid
  iniciadoPorNombre   String?
  completadoPorId     String?                 @db.Uuid
  completadoPorNombre String?
  /// Usuario que tomó el paso a SU mesa de trabajo (vista Por estación del
  /// tablero): reclamo visible para todos, persistente entre sesiones.
  mesaUsuarioId       String?                 @db.Uuid
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden               OrdenTrabajo            @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  item                OrdenTrabajoItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mesaUsuario         User?                   @relation("PasosEnMesa", fields: [mesaUsuarioId], references: [id], onDelete: SetNull)
  iniciadoPor         User?                   @relation("PasosIniciados", fields: [iniciadoPorId], references: [id], onDelete: SetNull)
  completadoPor       User?                   @relation("PasosCompletados", fields: [completadoPorId], references: [id], onDelete: SetNull)
  tramos              OrdenTrabajoPasoTramo[]

  /// Un solo paso por posición de la ruta. Es la garantía DURA contra la
  /// doble materialización: el backfill perezoso chequea "item sin pasos" y
  /// recién después inserta, así que dos lecturas simultáneas (o emitir la OT
  /// mientras el front abre el detalle) pueden ver cero pasos las dos y
  /// duplicar la ruta entera. Con el único, el perdedor de la carrera no
  /// inserta nada (createMany usa ON CONFLICT DO NOTHING).
  @@unique([itemId, indice])
  @@index([tenantId, ordenId])
  @@index([tenantId, itemId])
  @@index([tenantId, estado])
  @@index([tenantId, mesaUsuarioId])
  @@index([tenantId, maquinaId])
}

/// Sesión de trabajo sobre un paso (registro-tiempos-produccion D2): quién,
/// desde y hasta cuándo, y por qué terminó. El tiempo medido del paso es la
/// SUMA de sus tramos — habilita pausas con motivo, multi-operario y cierre
/// automático por jornada. Máximo un tramo abierto (finEl null) por paso.
/// Ver docs/registro-tiempos-produccion-diseno.md
model OrdenTrabajoPasoTramo {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  pasoId        String               @db.Uuid
  usuarioId     String?              @db.Uuid
  /// Nombre visible del actor (snapshot; el FK real es usuarioId).
  usuarioNombre String
  inicioEl      DateTime
  /// Null = tramo abierto (cronómetro corriendo).
  finEl         DateTime?
  /// 'completado' | 'pausa:<motivo D7>' | 'fin_jornada' | 'auto_pausa' |
  /// 'bloqueo' | 'migracion'.
  motivoFin     String?
  /// Texto libre cuando el motivo de pausa es 'otro'.
  motivoDetalle String?              @db.VarChar(300)
  /// 'usuario' | 'sistema' (cierres automáticos).
  origen        String               @default("usuario")
  createdAt     DateTime             @default(now())
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paso          OrdenTrabajoItemPaso @relation(fields: [pasoId], references: [id], onDelete: Cascade)
  usuario       User?                @relation("TramosPaso", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, pasoId])
  @@index([tenantId, finEl])
  @@index([tenantId, usuarioId, finEl])
}

/// Ahorro de material CONCRETADO al consolidar trabajos en el simulador
/// gran formato: una fila por tanda marcada impresa, con el consumo que
/// hubiera costado imprimir por separado (baseline del motor al cotizar)
/// vs. el consolidado real. Es el "cuánto ahorra la empresa gracias al
/// sistema" acumulado que muestra el Panel general.
model AhorroConsolidacion {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  /// Quién marcó la tanda (snapshot del nombre; FK puede quedar null).
  usuarioId            String?  @db.Uuid
  usuarioNombre        String
  materiaPrimaId       String?  @db.Uuid
  materiaPrimaNombre   String
  /// Código del catálogo de tecnologías (uv, dtf_textil, …).
  tecnologia           String?
  /// Trabajos consolidados en la tanda.
  jobs                 Int
  /// Rollo consumido si cada trabajo se imprimía por separado (ml).
  consumoSeparadoMl    Decimal  @db.Decimal(12, 2)
  /// Rollo consumido consolidado (ml).
  consumoConsolidadoMl Decimal  @db.Decimal(12, 2)
  ahorroMl             Decimal  @db.Decimal(12, 2)
  costoSeparado        Decimal? @db.Decimal(14, 2)
  costoConsolidado     Decimal? @db.Decimal(14, 2)
  /// Ahorro en pesos (null si el material no tiene precio por ml).
  ahorroPesos          Decimal? @db.Decimal(14, 2)
  /// Algún job de la tanda no tenía baseline: el ahorro es parcial.
  baselineParcial      Boolean  @default(false)
  createdAt            DateTime @default(now())
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario              User?    @relation("AhorrosConsolidacion", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model OrdenTrabajoEvento {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  ordenId       String       @db.Uuid
  fecha         DateTime     @default(now())
  /// 'emision' | 'numero_asignado' | 'borrador' | 'productos' | 'estado' |
  /// 'modificacion' | 'nota'.
  tipo          String
  descripcion   String
  /// Nombre visible del actor (snapshot; el FK real es usuarioId).
  usuarioNombre String
  /// FK real al usuario que ejecutó la acción; null para eventos de sistema.
  usuarioId     String?      @db.Uuid
  /// Diff estructurado para auditoría: { campo, antes, despues } u otros
  /// payloads según tipo. La descripción es el texto humano.
  datosJson     Json?
  /// 'usuario' | 'sistema' (a futuro: 'api').
  origen        String       @default("usuario")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden         OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario       User?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, ordenId, fecha])
}

/// Contador atómico para numeración OT-AAAA-NNNN por tenant/año.
model OrdenTrabajoContador {
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anio])
}

// === ADMINISTRACIÓN (pagos / tesorería) ===
// Ver docs/modulo-administracion-diseno.md. Catálogos por tenant: cómo
// entra la plata (comisión, IVA s/comisión, plazo, retención) y dónde.

model CuentaFondos {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  /// 'caja' | 'banco' | 'billetera' | 'cartera_valores'.
  tipo               String
  nombre             String
  banco              String?
  cbuAlias           String?
  moneda             String             @default("ARS") @db.VarChar(3)
  /// Denormalizado recalculable desde MovimientoFondos (etapa B).
  saldo              Decimal            @default(0) @db.Decimal(14, 2)
  activo             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metodosPagoDefault MetodoPago[]
  movimientos        MovimientoFondos[]
  cobrosDestino      Cobro[]
  pagosOrigen        Pago[]
  valoresDeposito    Valor[]

  @@unique([tenantId, nombre])
  @@index([tenantId, activo])
}

model MetodoPago {
  gastosFijosEstructura GastoFijoEstructura[]
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  codigo                String
  nombre                String
  /// 'efectivo' | 'transferencia' | 'billetera_qr' | 'tarjeta_debito' |
  /// 'tarjeta_credito' | 'cheque_echeq' | 'debito_automatico'.
  tipo                  String
  comisionPct           Decimal           @default(0) @db.Decimal(6, 3)
  ivaComisionPct        Decimal           @default(0) @db.Decimal(6, 3)
  plazoAcreditacionDias Int               @default(0)
  /// Sugiere cargar líneas de retención al registrar cobros con este método.
  sufreRetencion        Boolean           @default(false)
  cuentaDestinoId       String?           @db.Uuid
  activo                Boolean           @default(true)
  orden                 Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaDestino         CuentaFondos?     @relation(fields: [cuentaDestinoId], references: [id], onDelete: SetNull)
  cobros                Cobro[]
  pagos                 Pago[]
  recurrentes           GastoRecurrente[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

model MovimientoFondos {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  cuentaId           String        @db.Uuid
  fecha              DateTime      @default(now())
  /// 'entrada' | 'salida'.
  tipo               String
  monto              Decimal       @db.Decimal(14, 2)
  concepto           String
  /// 'cobro' | 'pago' | 'transferencia' | 'valor' | 'ajuste_arqueo'.
  origenTipo         String
  cobroId            String?       @db.Uuid
  /// Pago a proveedor que generó esta salida (docs/egresos-y-cuentas-por-pagar).
  pagoId             String?       @db.Uuid
  valorId            String?       @db.Uuid
  /// Movimiento espejo en la otra cuenta (transferencias).
  transferenciaParId String?       @db.Uuid
  /// Sólo en transferencias entre cuentas de DISTINTA moneda: unidades de la
  /// moneda destino por 1 de la de origen, derivado de lo que el usuario
  /// declaró que llegó (`montoDestino`). El doc del módulo lo especificaba
  /// desde el día uno y nunca se había implementado — la UI decía "se
  /// registra el tipo de cambio del día" y era mentira.
  tipoCambio         Decimal?      @db.Decimal(14, 4)
  ordenId            String?       @db.Uuid
  /// Saldo de la cuenta después de este movimiento (extracto corrido).
  saldoPosterior     Decimal       @db.Decimal(14, 2)
  /// 'pendiente' | 'conciliado' | 'diferencia' (para conciliación, F3).
  estadoConciliacion String        @default("pendiente")
  createdAt          DateTime      @default(now())
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuenta             CuentaFondos  @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  cobro              Cobro?        @relation(fields: [cobroId], references: [id])
  pago               Pago?         @relation(fields: [pagoId], references: [id])
  valor              Valor?        @relation(fields: [valorId], references: [id])
  orden              OrdenTrabajo? @relation(fields: [ordenId], references: [id])

  @@index([tenantId, cuentaId, fecha])
}

model Cobro {
  id                        String                @id @default(uuid()) @db.Uuid
  tenantId                  String                @db.Uuid
  clienteId                 String?               @db.Uuid
  ordenId                   String?               @db.Uuid
  fecha                     DateTime
  metodoPagoId              String                @db.Uuid
  cuentaDestinoId           String                @db.Uuid
  montoBruto                Decimal               @db.Decimal(14, 2)
  /// % de comisión efectivamente aplicado (editable sobre el del método).
  comisionPctAplicada       Decimal               @default(0) @db.Decimal(6, 3)
  comisionMonto             Decimal               @default(0) @db.Decimal(14, 2)
  comisionIvaMonto          Decimal               @default(0) @db.Decimal(14, 2)
  netoAcreditado            Decimal               @db.Decimal(14, 2)
  retencionesTotal          Decimal               @default(0) @db.Decimal(14, 2)
  disponibleReal            Decimal               @db.Decimal(14, 2)
  fechaAcreditacionEstimada DateTime?
  /// 'pendiente' | 'acreditado'. Los cheques acreditan vía su Valor.
  estadoAcreditacion        String                @default("pendiente")
  moneda                    String                @default("ARS") @db.VarChar(3)
  notas                     String?
  /// REC-AAAA-NNNN (ReciboContador). El recibo es el documento del cobro:
  /// 1:1 con él, sin entidad propia. Ver docs/recibos-pago-diseno.md
  numeroRecibo              String?               @unique
  /// "N° de operación" del medio de pago: el identificador que devuelve la
  /// transferencia, el cupón o el ticket. Es lo que el cliente reconoce.
  referencia                String?               @db.VarChar(60)
  /// Quién tomó el cobro, CONGELADO: el recibo se comparte y no puede mutar
  /// porque después alguien editó el legajo del empleado.
  registradoPorNombre       String?
  anuladoEl                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                   Cliente?              @relation(fields: [clienteId], references: [id])
  orden                     OrdenTrabajo?         @relation(fields: [ordenId], references: [id])
  metodoPago                MetodoPago            @relation(fields: [metodoPagoId], references: [id])
  cuentaDestino             CuentaFondos          @relation(fields: [cuentaDestinoId], references: [id])
  retenciones               RetencionPercepcion[]
  movimientos               MovimientoFondos[]
  valores                   Valor[]
  imputaciones              CobroImputacion[]
  archivos                  Archivo[]

  @@index([tenantId, ordenId])
  @@index([tenantId, clienteId])
  @@index([tenantId, estadoAcreditacion])
}

/// Numeración de recibos de pago por tenant y año (patrón OrdenTrabajoContador).
model ReciboContador {
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anio])
}

model RetencionPercepcion {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  cobroId        String?  @db.Uuid
  /// Pago a proveedor cuando la retención es PRACTICADA (se la retenemos al
  /// pagarle). Excluyente con cobroId: una es sufrida y la otra practicada.
  pagoId         String?  @db.Uuid
  /// 'sufrida' (nos retienen al cobrar) | 'practicada' (retenemos al pagar, F2).
  direccion      String   @default("sufrida")
  /// 'SIRCREB' | 'SIRTAC' | 'IIBB_CONVENIO' | 'SICORE_GANANCIAS' |
  /// 'IVA_RG2854' | 'PERCEPCION_IIBB' | 'otro'.
  regimen        String
  jurisdiccion   String?
  base           Decimal  @db.Decimal(14, 2)
  alicuota       Decimal  @db.Decimal(6, 3)
  monto          Decimal  @db.Decimal(14, 2)
  nroComprobante String?
  /// 'YYYY-MM' para el reporte del contador.
  periodoFiscal  String
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cobro          Cobro?   @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  pago           Pago?    @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([tenantId, periodoFiscal])
  @@index([tenantId, regimen])
}

model Valor {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  /// 'tercero' (recibido) | 'propio' (emitido).
  origen           String
  /// 'fisico' | 'echeq'.
  formato          String
  /// 'comun' | 'diferido'.
  modalidad        String
  numero           String
  banco            String
  importe          Decimal            @db.Decimal(14, 2)
  moneda           String             @default("ARS") @db.VarChar(3)
  fechaEmision     DateTime?
  fechaPago        DateTime?
  /// tercero: 'cartera' | 'endosado' | 'depositado' | 'acreditado' | 'rechazado'
  /// propio:  'cartera' | 'debitado' | 'rechazado'.
  estado           String             @default("cartera")
  clienteId        String?            @db.Uuid
  proveedorId      String?            @db.Uuid
  cobroId          String?            @db.Uuid
  cuentaDepositoId String?            @db.Uuid
  motivoRechazo    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente          Cliente?           @relation(fields: [clienteId], references: [id])
  proveedor        Proveedor?         @relation(fields: [proveedorId], references: [id])
  cobro            Cobro?             @relation(fields: [cobroId], references: [id])
  cuentaDeposito   CuentaFondos?      @relation(fields: [cuentaDepositoId], references: [id])
  movimientos      MovimientoFondos[]
  pagos            Pago[]

  @@index([tenantId, estado])
}

// === TAB PRECIO V2 ===
// Preserva la lógica del actual sistema de precios especiales por cliente
// adaptada al nuevo modelo de Producto.

model ProductoPrecioEspecialClienteV2 {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  productoId String   @db.Uuid
  clienteId  String   @db.Uuid
  /// Configuración del precio especial (mismo esquema que ProductoPrecioConfig del Tab Precio).
  configJson Json
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cliente    Cliente  @relation("ProductoPrecioEspecialClienteV2Cliente", fields: [clienteId], references: [id])

  @@unique([tenantId, productoId, clienteId])
  @@index([tenantId, clienteId])
}

// ═══════════════════════════════════════════════════════════════════════
// Administración · Configuración fiscal del emisor (etapa C)
// Ver docs/modulo-administracion-diseno.md
// ═══════════════════════════════════════════════════════════════════════

/// Datos fiscales del tenant como EMISOR. Junto con la condición del
/// receptor definen la letra del comprobante (ver letra-comprobante.ts).
/// Uno por tenant.
model ConfiguracionFiscal {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @unique @db.Uuid
  razonSocial          String
  /// CUIT del emisor, 11 dígitos sin guiones.
  cuit                 String       @db.VarChar(11)
  /// 'RI' | 'monotributo' | 'exento'. Un consumidor final no emite.
  condicionFiscal      String       @default("RI")
  /// Nº de inscripción en Ingresos Brutos (o convenio multilateral).
  ingresosBrutos       String?
  domicilioFiscal      String?
  inicioActividades    DateTime?
  /// Leyenda obligatoria en las facturas A cuando ARCA no reconoce
  /// solvencia patrimonial — reemplaza a la vieja factura M desde la
  /// RG 5762/2025: 'PAGO EN CBU INFORMADA' | 'OPERACIÓN SUJETA A RETENCIÓN'.
  leyendaFacturaA      String?
  /// 'manual' | 'tusfacturas'. Las credenciales del proveedor NO viven
  /// acá: se configuran en el módulo de Integraciones.
  proveedorFacturacion String       @default("manual")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntosVenta          PuntoVenta[]

  @@index([tenantId])
}

/// Punto de venta habilitado en ARCA. La numeración de comprobantes es
/// por (punto de venta, tipo, letra).
model PuntoVenta {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @db.Uuid
  configuracionFiscalId String                @db.Uuid
  /// Número que asignó ARCA (se muestra con 4 dígitos: 0001).
  numero                Int
  nombre                String
  /// 'web_services' (factura electrónica por API) | 'portal' (ARCA web) |
  /// 'talonario' (preimpreso). Sólo web_services puede emitir por provider.
  modalidad             String                @default("web_services")
  activo                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  configuracionFiscal   ConfiguracionFiscal   @relation(fields: [configuracionFiscalId], references: [id], onDelete: Cascade)
  comprobantes          Comprobante[]
  contadores            ComprobanteContador[]

  @@unique([tenantId, numero])
  @@index([tenantId, activo])
}

// ═══════════════════════════════════════════════════════════════════════
// Administración · Comprobantes (etapa C2)
// ═══════════════════════════════════════════════════════════════════════

/// Comprobante fiscal (factura / NC / ND). La letra sale de la matriz
/// emisor×receptor (letra-comprobante.ts) y se congela al crear.
model Comprobante {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  /// 'factura' | 'nota_credito' | 'nota_debito'
  tipo                String
  /// 'A' | 'B' | 'C' | 'E'
  letra               String    @db.VarChar(1)
  puntoVentaId        String    @db.Uuid
  /// Número dentro de (punto de venta, tipo, letra). Null mientras es
  /// borrador: se asigna recién al emitir, con el contador atómico.
  numero              Int?
  fecha               DateTime  @db.Date
  clienteId           String?   @db.Uuid
  /// DEPRECADO: reemplazado por la relación M-a-M `ordenes`
  /// (ComprobanteOrden). Se conserva hasta migrar los servicios que lo
  /// leen; no escribir más acá.
  ordenId             String?   @db.Uuid
  /// Datos del receptor congelados al crear: si el cliente después cambia
  /// de CUIT o de condición, el comprobante emitido NO cambia.
  receptorSnapshot    Json
  /// [{ descripcion, cantidad, precioUnitarioSinIva, alicuotaIva, ... }]
  itemsJson           Json
  netoGravado         Decimal   @db.Decimal(14, 2)
  /// [{ alicuota, base, monto }] — la A las discrimina; B/C/E no.
  ivaPorAlicuota      Json
  ivaTotal            Decimal   @default(0) @db.Decimal(14, 2)
  total               Decimal   @db.Decimal(14, 2)
  moneda              String    @default("ARS")
  cotizacion          Decimal?  @db.Decimal(14, 4)
  /// 'borrador' | 'emitido' | 'rechazado' | 'anulado'
  estado              String    @default("borrador")
  cae                 String?
  caeVencimiento      DateTime?
  /// Condición de venta y vencimiento: el aging de deudores depende de esto.
  condicionVenta      String?
  vencimiento         DateTime? @db.Date
  /// Leyenda RG 5762/2025 en las A ('PAGO EN CBU INFORMADA'…).
  leyenda             String?
  /// Errores de ARCA. Llegan como TEXTO LIBRE: no hay tabla pública de
  /// códigos, así que se guardan crudos para auditar.
  rechazoJson         Json?
  /// Respuesta cruda del provider (auditoría).
  providerRaw         Json?
  /// Clave anti-duplicado: se persiste ANTES de llamar al provider. Ante
  /// un timeout se consulta por ella, nunca se reintenta a ciegas —
  /// ningún provider garantiza idempotencia.
  idempotencyKey      String    @unique
  /// Saldo pendiente de cobro (total − imputaciones). Denormalizado, se
  /// mantiene en la misma transacción que las imputaciones.
  saldoPendiente      Decimal   @default(0) @db.Decimal(14, 2)
  /// Para NC/ND: el comprobante que corrigen.
  comprobanteOrigenId String?   @db.Uuid
  anuladoEl           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntoVenta        PuntoVenta         @relation(fields: [puntoVentaId], references: [id], onDelete: Restrict)
  cliente           Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  orden             OrdenTrabajo?      @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  comprobanteOrigen Comprobante?       @relation("ComprobanteCorrige", fields: [comprobanteOrigenId], references: [id], onDelete: SetNull)
  correcciones      Comprobante[]      @relation("ComprobanteCorrige")
  imputaciones      CobroImputacion[]
  ordenes           ComprobanteOrden[]
  archivos          Archivo[]

  @@unique([tenantId, puntoVentaId, tipo, letra, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, ordenId])
  @@index([tenantId, vencimiento])
}

/// Numeración atómica por (punto de venta, tipo, letra) — mismo patrón que
/// OrdenTrabajoContador. ARCA exige numeración correlativa sin huecos.
model ComprobanteContador {
  tenantId     String     @db.Uuid
  puntoVentaId String     @db.Uuid
  tipo         String
  letra        String     @db.VarChar(1)
  ultimo       Int        @default(0)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  puntoVenta   PuntoVenta @relation(fields: [puntoVentaId], references: [id], onDelete: Cascade)

  @@id([tenantId, puntoVentaId, tipo, letra])
}

/// Aplica un cobro a un comprobante. Un cobro sin imputaciones es un
/// anticipo a cuenta; la suma de imputaciones nunca supera ni al cobro ni
/// al saldo del comprobante.
model CobroImputacion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  cobroId       String   @db.Uuid
  comprobanteId String   @db.Uuid
  monto         Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cobro       Cobro       @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  comprobante Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@unique([cobroId, comprobanteId])
  @@index([tenantId, comprobanteId])
}

/// Aplica (parte de) un comprobante a una orden de trabajo. Un comprobante
/// puede cubrir varias órdenes (facturación en lote, un renglón por orden)
/// y una orden recibir varios comprobantes (facturas parciales). `monto` es
/// TOTAL (IVA incluido) en la moneda del comprobante. Invariante: la suma
/// de montos de un comprobante = comprobante.total (se reparte completo).
/// La deuda COMERCIAL no vive acá (nace de la orden al finalizar); esto es
/// la capa fiscal opcional. Ver docs/facturacion-ordenes-deuda-comercial-diseno.md
model ComprobanteOrden {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  comprobanteId String   @db.Uuid
  ordenId       String   @db.Uuid
  monto         Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comprobante Comprobante  @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@unique([comprobanteId, ordenId])
  @@index([tenantId, ordenId])
}

/// === EGRESOS Y CUENTAS POR PAGAR ===
/// Ver docs/egresos-y-cuentas-por-pagar-diseno.md

/// Qué ES el egreso, para los reportes. No confundir con "a qué se imputa": la
/// naturaleza dice dónde suma (o si no suma), la imputación dice qué análisis
/// habilita. Es el eje que evita que una multa entre en la tarifa de una máquina
/// y que un adelanto de sueldo se cuente como gasto.
enum NaturalezaEgreso {
  /// Material, tercerizado, consumibles, repuestos de máquina.
  COSTO_PRODUCCION
  /// No varía con el trabajo: alquiler, sueldos, servicios, multas.
  GASTO_ESTRUCTURA
  /// Capex: una máquina, una obra. Sale plata pero no es gasto del período.
  INVERSION
  /// Distribución de utilidades. No es gasto.
  RETIRO_SOCIOS
  /// Adelantos, préstamos, ajustes de caja: mueve caja, NO afecta resultado.
  NO_RESULTADO
}

/// Árbol de clasificación de egresos: CURADO y editable.
///
/// Se siembra al crear el tenant y se puede renombrar, reordenar, desactivar y
/// extender. Las de sistema (`esSistema`) no se borran —hay historia colgada— y
/// ninguna con egresos se puede borrar.
///
/// Dos niveles a propósito: el plan de cuentas de la competencia tiene tres y 80+
/// hojas, y nadie lo mantiene. La AMORTIZACIÓN no está en este árbol a propósito:
/// no es un egreso (no sale plata) y vive sólo en GastoFijoEstructura.
model CategoriaEgreso {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  /// Slug estable: el nombre se puede editar, el código es la identidad.
  codigo      String
  nombre      String
  naturaleza  NaturalezaEgreso
  padreId     String?           @db.Uuid
  esSistema   Boolean           @default(false)
  activo      Boolean           @default(true)
  orden       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  padre       CategoriaEgreso?  @relation("CategoriaEgresoPadre", fields: [padreId], references: [id], onDelete: Restrict)
  hijos       CategoriaEgreso[] @relation("CategoriaEgresoPadre")
  egresos     Egreso[]
  recurrentes GastoRecurrente[]
  gastosFijos GastoFijoEstructura[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

/// La OBLIGACIÓN (o el gasto de contado). Lo que sale, o va a salir, de la caja.
///
/// Tiene TRES fechas y no una, que es el nudo del módulo:
///   competencia  — a qué mes PERTENECE el gasto (la luz de julio pagada en agosto)
///   vencimiento  — cuándo hay que pagarlo; NULL = contado, no entra en CxP
///   la del pago  — la ponen los Pago, que son entidades aparte
///
/// "Cuentas por pagar" NO es una tabla: es el filtro de los egresos con
/// vencimiento y estado pendiente/parcial.
model Egreso {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  /// EGR-AAAA-NNNN, atómico vía EgresoContador.
  numero                String
  descripcion           String
  categoriaEgresoId     String    @db.Uuid
  /// Null = egreso sin proveedor: la multa, el adelanto, el flete sin factura.
  /// Opcional a propósito: si fuera obligatorio, la caja chica quedaría afuera
  /// del sistema y el módulo no serviría para la mitad de los casos reales.
  proveedorId           String?   @db.Uuid
  /// A quién se le paga, CONGELADO. Texto libre cuando no hay proveedor.
  beneficiarioNombre    String
  fechaCompetencia      DateTime  @db.Date
  /// Null = contado (nace pagado y nunca pisa Cuentas por pagar).
  fechaVencimiento      DateTime? @db.Date
  moneda                String    @default("ARS") @db.VarChar(3)
  /// Neto e IVA SEPARADOS desde el día uno: es lo que habilita el Libro IVA
  /// Compras sin migrar nada, y el crédito fiscal es plata real.
  neto                  Decimal   @db.Decimal(14, 2)
  iva                   Decimal   @default(0) @db.Decimal(14, 2)
  otrosImpuestos        Decimal   @default(0) @db.Decimal(14, 2)
  total                 Decimal   @db.Decimal(14, 2)
  /// Σ PagoImputacion.monto, mantenido en la MISMA transacción que el pago
  /// (patrón cobradoTotal/facturadoTotal de OrdenTrabajo).
  pagadoTotal           Decimal   @default(0) @db.Decimal(14, 2)
  /// 'FA'|'FB'|'FC'|'ND'|'NC'|'TICKET'|'RECIBO'|'SIN_DOCUMENTO'.
  tipoComprobante       String?
  puntoVenta            String?
  numeroComprobante     String?
  /// 'pendiente' | 'parcial' | 'pagado' | 'anulado'.
  estado                String    @default("pendiente")
  /// 'manual' | 'recurrente'.
  origen                String    @default("manual")
  /// Imputaciones, todas opcionales e independientes entre sí.
  centroCostoId         String?   @db.Uuid
  /// Puente con el presupuestado para el reporte "presupuestado vs real" (F3).
  gastoFijoEstructuraId String?   @db.Uuid
  /// Plantilla que lo emitió (F3). Con el período de competencia forma el
  /// único que hace idempotente la generación mensual.
  gastoRecurrenteId     String?   @db.Uuid
  /// 'YYYY-MM' del período generado. Sólo en egresos de origen 'recurrente'.
  periodoRecurrente     String?
  /// Adelantos de sueldo y gastos atribuibles a una persona.
  empleadoId            String?   @db.Uuid
  anuladoEl             DateTime?
  motivoAnulacion       String?
  /// Quién lo cargó, congelado: el legajo puede cambiar y el historial no.
  registradoPorNombre   String?
  notas                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria    CategoriaEgreso      @relation(fields: [categoriaEgresoId], references: [id], onDelete: Restrict)
  proveedor    Proveedor?           @relation(fields: [proveedorId], references: [id])
  centroCosto  CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  gastoFijo    GastoFijoEstructura? @relation(fields: [gastoFijoEstructuraId], references: [id])
  recurrente   GastoRecurrente?     @relation(fields: [gastoRecurrenteId], references: [id])
  empleado     Empleado?            @relation(fields: [empleadoId], references: [id])
  imputaciones PagoImputacion[]
  archivos     Archivo[]

  @@unique([tenantId, numero])
  /// ANTIDUPLICADO: la misma factura del mismo proveedor no se carga dos veces.
  /// Es el error de carga manual más común y el más caro. Funciona como índice
  /// parcial de hecho: en Postgres los NULL no colisionan, así que los gastos
  /// sin documento (multas, caja chica) no se estorban entre sí.
  @@unique([tenantId, proveedorId, tipoComprobante, puntoVenta, numeroComprobante])
  /// IDEMPOTENCIA de la generación mensual: una plantilla emite UN egreso por
  /// período. Sin esto, dos instancias del cron corriendo a la vez —o un
  /// reintento— duplicarían el alquiler del mes.
  @@unique([gastoRecurrenteId, periodoRecurrente])
  @@index([tenantId, estado])
  @@index([tenantId, fechaVencimiento])
  @@index([tenantId, fechaCompetencia])
  @@index([tenantId, proveedorId])
  @@index([tenantId, categoriaEgresoId])
}

/// Plantilla que emite egresos sola, mes a mes: el alquiler, la luz, el
/// contador. Ver docs/egresos-y-cuentas-por-pagar-diseno.md §4.5
///
/// El `monto` es una SUGERENCIA y no una verdad: la luz no viene igual dos
/// meses seguidos. El egreso se genera pendiente con ese importe y quien lo
/// paga lo corrige. Sin esa aclaración la herramienta mentiría con precisión.
model GastoRecurrente {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  descripcion           String
  categoriaEgresoId     String   @db.Uuid
  proveedorId           String?  @db.Uuid
  monto                 Decimal  @db.Decimal(14, 2)
  moneda                String   @default("ARS") @db.VarChar(3)
  metodoPagoId          String?  @db.Uuid
  /// 'mensual' | 'bimestral' | 'trimestral' | 'semestral' | 'anual'.
  frecuencia            String   @default("mensual")
  /// Día del mes en que vence (1-31), con clamp a fin de mes corto: un
  /// vencimiento el 31 en febrero cae el 28, no se saltea.
  diaVencimiento        Int      @default(10)
  /// 'YYYY-MM' — primer período que emite (inclusive).
  vigenteDesde          String
  /// 'YYYY-MM' — último período (inclusive); null = indefinido.
  vigenteHasta          String?
  /// El puente con el PRESUPUESTADO: si apunta a un gasto fijo, el reporte
  /// puede comparar lo que se planificó contra lo que realmente se pagó.
  gastoFijoEstructuraId String?  @db.Uuid
  activo                Boolean  @default(true)
  /// 'YYYY-MM' del último período emitido. Primera barrera de idempotencia;
  /// la dura es el único de Egreso.
  ultimoPeriodoGenerado String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria  CategoriaEgreso      @relation(fields: [categoriaEgresoId], references: [id], onDelete: Restrict)
  proveedor  Proveedor?           @relation(fields: [proveedorId], references: [id])
  metodoPago MetodoPago?          @relation(fields: [metodoPagoId], references: [id])
  gastoFijo  GastoFijoEstructura? @relation(fields: [gastoFijoEstructuraId], references: [id])
  egresos    Egreso[]

  @@index([tenantId, activo])
}

/// El ACTO de pagar — espejo de Cobro.
///
/// Existe separado del Egreso porque un pago cubre VARIAS facturas, puede ser
/// parcial, y las retenciones se practican al pagar (no cuando nace el gasto).
/// La UI colapsa los dos en un solo gesto cuando coinciden, que es el 80%.
model Pago {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  /// OP-AAAA-NNNN: la orden de pago que se le manda al proveedor.
  numero              String
  fecha               DateTime
  metodoPagoId        String    @db.Uuid
  cuentaOrigenId      String    @db.Uuid
  /// Lo que se imputa a los egresos.
  montoBruto          Decimal   @db.Decimal(14, 2)
  /// Retenciones PRACTICADAS (F2): reducen lo que sale sin reducir lo saldado.
  retencionesTotal    Decimal   @default(0) @db.Decimal(14, 2)
  /// montoBruto − retenciones: lo que efectivamente sale de la cuenta.
  montoNeto           Decimal   @db.Decimal(14, 2)
  moneda              String    @default("ARS") @db.VarChar(3)
  /// Sólo si la cuenta está en otra moneda que el egreso (patrón transferencia).
  tipoCambio          Decimal?  @db.Decimal(14, 4)
  proveedorId         String?   @db.Uuid
  /// N° de operación del medio de pago: transferencia, cupón, ticket.
  referencia          String?   @db.VarChar(60)
  /// Cheque propio emitido (F2). Valor ya soporta origen 'propio'.
  valorId             String?   @db.Uuid
  anuladoEl           DateTime?
  motivoAnulacion     String?
  registradoPorNombre String?
  notas               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metodoPago   MetodoPago            @relation(fields: [metodoPagoId], references: [id])
  cuentaOrigen CuentaFondos          @relation(fields: [cuentaOrigenId], references: [id])
  proveedor    Proveedor?            @relation(fields: [proveedorId], references: [id])
  valor        Valor?                @relation(fields: [valorId], references: [id])
  imputaciones PagoImputacion[]
  movimientos  MovimientoFondos[]
  retenciones  RetencionPercepcion[]

  @@unique([tenantId, numero])
  @@index([tenantId, fecha])
  @@index([tenantId, proveedorId])
}

/// Qué egresos salda un pago y por cuánto — espejo de CobroImputacion.
model PagoImputacion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  pagoId    String   @db.Uuid
  egresoId  String   @db.Uuid
  monto     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pago   Pago   @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  egreso Egreso @relation(fields: [egresoId], references: [id], onDelete: Cascade)

  @@unique([pagoId, egresoId])
  @@index([tenantId, egresoId])
}

model EgresoContador {
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anio])
}

model PagoContador {
  tenantId String @db.Uuid
  anio     Int
  ultimo   Int    @default(0)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, anio])
}

/// Archivo almacenado en object storage (Cloudflare R2 en producción, disco
/// en dev). La fila es la fuente de verdad: el objeto sólo se alcanza por una
/// URL presignada de vida corta que el API firma DESPUÉS de validar esta fila
/// contra el tenant. El bucket es privado siempre.
///
/// Adjuntable a varias entidades con FKs tipadas nullables en vez de un
/// `entidadId` polimórfico: así el borrado en cascada es real y no quedan
/// huérfanos que sólo un barrido pueda descubrir. Exactamente una FK está
/// seteada, según `scope` (ninguna para TENANT_BRANDING).
/// Ver docs/archivos-r2-diseno.md
model Archivo {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  scope             ArchivoScope
  /// Clave en el bucket: t/{tenantId}/{scope}/{entidadId}/{archivoId}{ext}.
  /// El nombre original NUNCA va acá (path traversal, unicode, colisiones).
  key               String        @unique
  /// Nombre con el que el usuario lo subió; se devuelve en el
  /// Content-Disposition de la descarga.
  nombreOriginal    String
  /// MIME verificado contra el objeto real en el confirmar, no el declarado.
  mimeType          String
  bytes             BigInt        @default(0)
  /// sha256 en hex del contenido, si el cliente lo aportó. Dedupe futuro.
  hash              String?
  /// Subida en partes en curso. Se guarda para poder abortarla desde el
  /// barrido: S3 y R2 cobran las partes de un multipart que nunca cerró.
  multipartUploadId String?
  estado            ArchivoEstado @default(PENDIENTE)
  /// Opt-in explícito: sólo los marcados así se ven en el link público de
  /// seguimiento del cliente. El arte de producción no se filtra por defecto.
  publico           Boolean       @default(false)
  /// Lo produjo el sistema (PDF de presupuesto, de comprobante), no lo subió
  /// una persona. No aparece en el tab de archivos, no se re-vincula al
  /// convertir y no se borra a mano: es una proyección de otra fila, y
  /// mezclarlo con el arte del cliente confundiría las dos cosas.
  generado          Boolean       @default(false)
  /// Qué automatismo lo produjo ("sello" = el arte del configurador). Distinto
  /// de `generado`: estos SÍ son adjuntos normales —se listan, se descargan y
  /// cuentan para la cuota—, porque el taller los usa como usaría el archivo
  /// que mandó el cliente. La marca existe para poder REEMPLAZARLOS cuando el
  /// diseño cambia sin tocar lo que subió una persona.
  autogeneradoPor   String?
  descripcion       String?
  subidoPorId       String?       @db.Uuid
  eliminadoEl       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  clienteId     String? @db.Uuid
  ordenId       String? @db.Uuid
  ordenItemId   String? @db.Uuid
  cotizacionId  String? @db.Uuid
  comprobanteId String? @db.Uuid
  cobroId       String? @db.Uuid
  egresoId      String? @db.Uuid
  productoId    String? @db.Uuid
  proveedorId   String? @db.Uuid

  tenant      Tenant            @relation("ArchivosDelTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  subidoPor   User?             @relation("ArchivosSubidos", fields: [subidoPorId], references: [id], onDelete: SetNull)
  cliente     Cliente?          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orden       OrdenTrabajo?     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenItem   OrdenTrabajoItem? @relation(fields: [ordenItemId], references: [id], onDelete: Cascade)
  cotizacion  Cotizacion?       @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  comprobante Comprobante?      @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  cobro       Cobro?            @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  egreso      Egreso?           @relation(fields: [egresoId], references: [id], onDelete: Cascade)
  producto    Producto?         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  proveedor   Proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  tenantsConEsteLogo Tenant[] @relation("TenantLogo")

  @@index([tenantId, scope, estado])
  @@index([tenantId, scope, generado])
  @@index([tenantId, ordenItemId])
  @@index([tenantId, ordenId])
  @@index([tenantId, clienteId])
  @@index([tenantId, cotizacionId])
  @@index([tenantId, egresoId])
  @@index([estado, createdAt])
}

/// Conexión de un tenant con un proveedor externo.
///
/// Una fila por (tenant, proveedor). Es compartida a propósito: Wati, AFIP y
/// Mercado Pago guardan secretos con las mismas exigencias, y tres tablas
/// distintas significarían tres implementaciones distintas del cifrado.
///
/// Ver docs/integraciones-wati-diseno.md
model IntegracionTenant {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  proveedor ProveedorIntegracion
  estado    EstadoIntegracion    @default(DESCONECTADA)

  /// Credenciales CIFRADAS (AES-256-GCM): { v, iv, tag, ct }. La clave vive
  /// en el entorno, nunca acá — si vivieran juntas, cifrar no protegería de
  /// lo único de lo que tiene que proteger: que se lleven la base.
  /// El token NUNCA vuelve por la API: para la UI está `pista`.
  credencialesCifradas Json?
  /// Últimos caracteres del secreto, para que la UI diga cuál está cargado
  /// sin poder revelarlo.
  pista                String?

  /// Metadata NO sensible y mostrable: número de WhatsApp, nombre visible,
  /// id de la cuenta en el proveedor. Se puede leer y loguear sin riesgo.
  metadataJson     Json?
  /// Última vez que se verificó que la conexión responde.
  ultimoChequeoEl  DateTime?
  /// Por qué está en ERROR, en castellano y mostrable al usuario.
  ultimoErrorTexto String?

  conectadaEl    DateTime?
  conectadaPorId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conectadaPor User?  @relation("IntegracionesConectadas", fields: [conectadaPorId], references: [id], onDelete: SetNull)

  /// Un tenant no puede tener dos conexiones al mismo proveedor.
  @@unique([tenantId, proveedor])
  @@index([tenantId, estado])
}

/// Tipos de link público que emite el sistema. Cada uno tiene su prefijo de
/// una letra en la URL que ve el cliente (grafoprint.com.ar/<letra>/<token>);
/// el mapa vive en src/lib/enlaces-publicos.ts y NO se repinta: cambiar una
/// letra invalida links ya enviados por WhatsApp.
enum TipoEnlacePublico {
  /// /t/ — seguimiento de una OT.
  SEGUIMIENTO_OT
  /// /p/ — ver y aprobar un presupuesto.
  PRESUPUESTO
  /// /f/ — comprobante (factura, NC).
  FACTURA
  /// /r/ — remito de entrega.
  REMITO
  /// /c/ — link de pago (cobro). La `p` ya se la lleva presupuesto.
  COBRO
  /// /e/ — encuesta de satisfacción.
  ENCUESTA
}

/// Credencial de TODO link público del sistema, en una sola tabla.
///
/// El token ES la autorización: quien lo tiene ve la entidad, sin sesión. Por
/// eso vive acá y no como una columna por entidad — así un tipo de link nuevo
/// (factura, remito, encuesta) es una fila más y no una migración, y todos
/// heredan gratis caducidad, revocación y métrica de apertura.
///
/// `OrdenTrabajo.publicToken` y `Cotizacion.publicToken` siguen existiendo
/// como puntero denormalizado para la UI (mismo patrón que
/// OrdenTrabajo.facturadoTotal), pero la RESOLUCIÓN pública pasa siempre por
/// acá. Ver docs/enlaces-publicos-diseno.md
model EnlacePublico {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  /// 12 chars url-safe (9 bytes aleatorios en base64url, 72 bits). Los
  /// tokens históricos de 22 chars siguen siendo válidos: el lookup es por
  /// igualdad exacta, no por largo.
  token          String            @unique
  tipo           TipoEnlacePublico
  /// Id de la entidad apuntada. Sin FK: el tipo decide a qué tabla mira.
  entidadId      String            @db.Uuid
  /// Null = no caduca (hoy el caso de todos).
  expiraEl       DateTime?
  /// Cortar el acceso sin borrar la fila ni perder la métrica.
  revocadoEl     DateTime?
  visitas        Int               @default(0)
  /// Primera apertura: el "visto" del cliente, dato comercial.
  primeraVistaEl DateTime?
  ultimaVistaEl  DateTime?
  createdAt      DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Un link vivo por entidad: re-emitir pisa el token anterior.
  @@unique([tipo, entidadId])
  @@index([tenantId, tipo])
}

/// Cupón de descuento (F4 descuentos — docs/descuentos-diseno.md §5.3).
/// Es una FUENTE AUTORIZADA del mismo descuento por línea de F1: quien lo
/// crea (supervisor/admin) define reglas y vigencia; aplicarlo no gatea.
model Cupon {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  /// Tecleable o escaneable: el QR codifica este código plano (el lector 2D
  /// lo tipea como teclado). Se guarda en MAYÚSCULAS.
  codigo       String
  descripcion  String?
  /// PORCENTAJE | MONTO — mismo contrato que el descuento manual.
  tipo         String
  valor        Decimal   @db.Decimal(14, 2)
  /// ORDEN | CATEGORIA | SUBCATEGORIA | PRODUCTO | CLIENTE. Sin FK: el tipo
  /// decide a qué catálogo apunta `alcanceRef` (código de categoría/
  /// subcategoría, id de producto, id de cliente; null si ORDEN).
  alcanceTipo  String    @default("ORDEN")
  alcanceRef   String?
  /// Neto mínimo de la orden para poder aplicarlo (null = sin mínimo).
  montoMinimo  Decimal?  @db.Decimal(14, 2)
  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  /// null = ilimitado; 1 = sorteo de un solo uso.
  usoMax       Int?
  usoCount     Int       @default(0)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redenciones CuponRedencion[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

/// Redención de un cupón: auditoría + el candado del "un solo uso". Se crea
/// en la MISMA transacción que emite la OT (reserva atómica); cancelar la
/// orden la libera (borra la fila y decrementa el contador).
model CuponRedencion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  cuponId       String   @db.Uuid
  ordenId       String   @db.Uuid
  montoAplicado Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cupon  Cupon  @relation(fields: [cuponId], references: [id], onDelete: Cascade)

  /// Un cupón se redime una sola vez por orden.
  @@unique([cuponId, ordenId])
  @@index([tenantId, cuponId])
}

/// Auditoría del control plane: todo lo que el staff ESCRIBE queda acá,
/// append-only (la app nunca lo edita ni borra). Nivel plataforma: vive por
/// encima de los tenants y está exento del tenant-guard.
///
/// `tenantAfectadoId` se llama así y NO `tenantId` a propósito: no es el
/// scoping multi-tenant, es una referencia al tenant sobre el que se actuó —
/// y llamarlo tenantId lo metería en la excepción peligrosa del spec de
/// aislamiento (modelos con tenantId exentos del guard, confinados a auth).
/// Sin FK: el evento tiene que sobrevivir a la baja del tenant.
/// Ver docs/control-plane-diseno.md
model PlataformaEvento {
  id               String   @id @default(uuid()) @db.Uuid
  staffUserId      String   @db.Uuid
  /// 'rol_otorgado' | 'rol_revocado' | 'tenant_creado' | 'tenant_suspendido' | …
  tipo             String
  tenantAfectadoId String?  @db.Uuid
  descripcion      String
  datosJson        Json?
  createdAt        DateTime @default(now())

  /// Restrict: quien actuó como staff no se borra (se desactiva). Borrar al
  /// actor dejaría auditoría sin autor.
  staff User @relation("EventosDeStaff", fields: [staffUserId], references: [id], onDelete: Restrict)

  @@index([staffUserId, createdAt])
  @@index([tenantAfectadoId])
}

/// Catálogo de planes del SaaS. Nivel plataforma (sin tenantId), como
/// MaterialPreset: los mismos planes para todos los tenants.
/// Ver docs/control-plane-diseno.md
model Plan {
  id                 String        @id @default(uuid()) @db.Uuid
  /// "trial" | "taller" | "estudio" | "diamante" — estable, es la clave.
  codigo             String        @unique
  nombre             String
  /// La bajada comercial que ve el tenant en la tarjeta del plan ("Para
  /// imprentas que arrancan a ordenar su producción"). Editable desde la
  /// consola: es copy de producto, cambia sin deploy.
  descripcion        String?
  /// ESPEJO del precio que vive en Paddle, cacheado para mostrarlo (consola,
  /// MRR, vista del tenant) sin pegarle a la API. La fuente de verdad del
  /// monto es el catálogo de Paddle: esto se sincroniza, no se edita a mano.
  precioMensual      Decimal       @db.Decimal(14, 2)
  /// Moneda del precio. Paddle cobra en USD; el riel argentino (MercadoPago)
  /// llegará con ARS. Ver docs/suscripciones-cobro-diseno.md
  moneda             String        @default("USD")
  /// Qué habilita y hasta dónde: { afip, whatsapp, usuariosMax,
  /// ordenesMesMax, storageGb }. JSON a propósito: los features cambian más
  /// rápido que el schema. NADIE lo lee directo salvo SuscripcionesService.
  /// Esto NO va a Paddle: es el patrón que recomienda su propia doc — precio
  /// en Paddle, entitlements en nuestro código.
  featuresJson       Json
  /// Precio y producto en el catálogo de Paddle. Null = plan no vendible por
  /// Paddle todavía (p. ej. "trial", o los planes legacy).
  paddlePriceId      String?       @unique
  paddleProductId    String?
  /// Variante ANUAL del mismo plan: otro precio en Paddle, mismo producto.
  /// Null = el plan sólo se vende mensual. El ahorro contra 12 meses lo
  /// calcula el front con estos dos números.
  paddlePriceIdAnual String?       @unique
  precioAnual        Decimal?      @db.Decimal(14, 2)
  /// Días de prueba que otorga este plan al asignarse. Null = sin prueba.
  /// Vive en el plan (no hardcodeado) para poder cambiarlo sin deploy.
  trialDias          Int?
  activo             Boolean       @default(true)
  orden              Int           @default(0)
  suscripciones      Suscripcion[]
}

/// La suscripción del tenant: una por tenant. CON tenantId y SIN eximir del
/// guard, a propósito: el propio tenant la lee (para sus feature gates) y el
/// control plane —sin contexto— la escribe. Sin suscripción = tenant legacy:
/// se lo trata como ilimitado (grandfathered) hasta que se le asigne plan.
model Suscripcion {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @unique @db.Uuid
  planId             String    @db.Uuid
  /// 'activa' | 'suspendida' | 'baja' — estado NORMALIZADO nuestro, el que
  /// mira el gate por plan. No es el de Paddle: ver estadoProveedor.
  estado             String    @default("activa")
  /// Quién cobra: 'paddle' | 'mercadopago' | 'manual'. "manual" son los
  /// legacy/cortesía que no pasan por ninguna pasarela.
  proveedor          String    @default("manual")
  /// Id de la suscripción en el proveedor (subscription_id de Paddle).
  referenciaExterna  String?   @unique
  /// Id del cliente en el proveedor (customer_id de Paddle), para abrir el
  /// customer portal sin volver a buscarlo.
  clienteExternoId   String?
  /// El estado CRUDO del proveedor (active | trialing | past_due | paused |
  /// canceled). Se guarda sin traducir para no perder información: 'past_due'
  /// mapea a estado 'activa' (hay ventana de dunning) pero enciende el banner.
  estadoProveedor    String?
  /// Próximo cobro informado por el proveedor (para la vista del tenant).
  proximoCobro       DateTime?
  /// Inicio del período de facturación en curso (current_billing_period de
  /// Paddle). Junto con `proximoCobro` da el largo REAL del ciclo, que es lo
  /// que permite mostrar "faltan X de N días" sin asumir 30 —un plan anual
  /// tiene 365. Nullable: las filas viejas se completan con el próximo evento.
  periodoDesde       DateTime?
  /// Cambio PROGRAMADO en la pasarela: 'cancel' | 'pause' | 'resume', con la
  /// fecha en que se hace efectivo. Existe porque al cancelar, Paddle deja la
  /// suscripción en `active` con un scheduled_change hasta el fin del período:
  /// sin esto la pantalla diría "Activa" y el cliente no vería que se termina.
  cambioProgramado   String?
  cambioProgramadoEl DateTime?
  /// Fin de la prueba gratuita. Los días restantes NO se guardan: se calculan
  /// contra esta fecha, así nunca quedan desactualizados. Al vencer, el cron
  /// pasa la suscripción a 'suspendida' — cierra los gates por plan pero el
  /// tenant sigue entrando y viendo sus datos. Ver docs/suscripciones-cobro-diseno.md
  trialHasta         DateTime?
  desde              DateTime  @default(now())
  hasta              DateTime?
  notas              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  /// El cron que vence las pruebas barre por esta fecha todas las noches.
  @@index([trialHasta])
}

/// Eventos de cobro recibidos de una pasarela (webhooks). Existe para dos
/// cosas: IDEMPOTENCIA (Paddle reintenta, y un reintento no debe duplicar
/// efectos) y rastro de auditoría de por qué una suscripción cambió de estado.
/// Sin tenantId a propósito: el webhook llega sin contexto de tenant, y el
/// tenant se resuelve después mirando la referencia externa.
/// Ver docs/suscripciones-cobro-diseno.md
model EventoCobro {
  id          String    @id @default(uuid()) @db.Uuid
  /// 'paddle' | 'mercadopago'
  proveedor   String
  /// Id del evento en el proveedor. UNIQUE = la idempotencia.
  eventoId    String    @unique
  /// p. ej. 'subscription.updated', 'transaction.completed'
  tipo        String
  payloadJson Json
  /// Null mientras no se procesó; con fecha una vez aplicado.
  procesadoEl DateTime?
  /// Si el procesamiento falló, queda acá para poder reintentar a mano.
  errorTexto  String?
  recibidoEl  DateTime  @default(now())

  @@index([proveedor, tipo])
  @@index([recibidoEl])
}

/// Una entrada de staff a un tenant (etapa C). Nivel plataforma: junta al
/// STAFF que entra y al TENANT al que entra, con motivo obligatorio y
/// vencimiento. Nunca es god-mode silencioso — todo queda acá y el cliente
/// lo ve. Ver docs/control-plane-diseno.md
///
/// `tenantId`/`staffUserId` sin FK y con esos nombres: sobreviven a la baja
/// del tenant/usuario (el rastro no se borra) y no caen en la excepción del
/// spec de aislamiento.
model SesionImpersonacion {
  id           String    @id @default(uuid()) @db.Uuid
  staffUserId  String    @db.Uuid
  tenantId     String    @db.Uuid
  /// Obligatorio y visible al tenant: "ticket #412, no le sale el PDF".
  motivo       String
  creadaEl     DateTime  @default(now())
  /// Corta sola. Renovar = otra sesión (otro registro), nunca extender.
  expiraEl     DateTime
  /// Cierre explícito (salir) o por el barrido de expiradas.
  cerradaEl    DateTime?
  /// Cómo terminó: 'salida' | 'expirada' | null (activa).
  motivoCierre String?

  authSession AuthSession?

  @@index([tenantId, creadaEl])
  @@index([staffUserId])
}
