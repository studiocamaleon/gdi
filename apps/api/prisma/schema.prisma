  materiaPrimaVariante   MateriaPrimaVariante    @relation("MaquinaConsumibleMateriaPrimaVariante", fields: [materiaPrimaVarianteId], references: [id], onDelete: Restrict)

  @@index([tenantId, maquinaId, activo])
  @@index([tenantId, perfilOperativoId])
  @@index([tenantId, materiaPrimaVarianteId, activo])
}

/// Pieza que se gasta con el uso de la máquina (drum, fusor, cuchilla…). El
/// costo se prorratea por CLICKS: a diferencia del tóner, el desgaste no
/// depende de la cobertura sino de cuántas páginas pasaron.
/// Ver docs/costo-por-click-desgaste-diseno.md
model MaquinaComponenteDesgaste {
  id                     String                        @id @default(uuid()) @db.Uuid
  tenantId               String                        @db.Uuid
  maquinaId              String                        @db.Uuid
  /// Repuesto en inventario. Opcional: se puede declarar sólo el precio
  /// (`precioUnitario`) mientras la pieza no esté dada de alta.
  materiaPrimaVarianteId String?                       @db.Uuid
  /// Precio del repuesto cuando NO se vincula una variante de inventario.
  /// Si hay variante, manda el precio de referencia de la variante.
  precioUnitario         Decimal?                      @db.Decimal(14, 2)
  /// La pieza sólo se gasta imprimiendo en color (drums/reveladores CMY).
  /// Fusor, correa y cuchillas giran siempre: van en false.
  soloColor              Boolean                       @default(false)
  nombre                 String
  tipo                   TipoComponenteDesgasteMaquina
  vidaUtilEstimada       Decimal?                      @db.Decimal(12, 2)
  unidadDesgaste         UnidadDesgasteMaquina
  modoProrrateo          String?
  activo                 Boolean                       @default(true)
  detalleJson            Json?
  observaciones          String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  tenant                 Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maquina                Maquina                       @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  materiaPrimaVariante   MateriaPrimaVariante?         @relation("MaquinaDesgasteMateriaPrimaVariante", fields: [materiaPrimaVarianteId], references: [id], onDelete: Restrict)

  @@index([tenantId, maquinaId, activo])
  @@index([tenantId, materiaPrimaVarianteId, activo])
}

/// Estación de trabajo del taller: agrupa familias de pasos (qué se hace),
/// máquinas (con qué) y empleados habilitados (quiénes). El paso llega a su
/// estación por la FAMILIA (una familia vive en una sola estación).
/// Ver docs/estaciones-diseno.md
model Estacion {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  nombre               String
  descripcion          String?
  /// Etapa productiva FIJA del catálogo ('preprensa' | 'impresion' |
  /// 'postprensa' | 'terminaciones' | 'instalacion' | 'qa-despacho').
  /// Ordena y agrupa las estaciones en las vistas operativas.
  etapa                String             @default("preprensa")
  /// Clave del set de iconos del tablero (Printer, Cut, Shield, …).
  icono                String?
  /// PUESTOS de trabajo simultáneos: multiplican las horas del calendario
  /// (capacidad en tiempo), NO son denominador de conteo de pasos.
  /// Ver docs/capacidad-estaciones-diseno.md D4.
  capacidadConcurrente Int                @default(1)
  /// Minutos que cuesta traer el material hasta acá y dejarlo listo antes de
  /// empezar a trabajar. Ocupa un PUESTO (lo hace el operario), pero no la
  /// máquina. null = usar el default del tenant (ConfiguracionProduccion).
  tiempoPreparacionMin Int?
  /// Calendario semanal operativo (D2). Shape validado en el service:
  /// { dias: { lun: { desde: "08:00", hasta: "18:00" } | null, …, dom: null } }
  /// null = sin calendario (el tablero no proyecta la cola en días).
  calendarioJson       Json?
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familias             EstacionFamilia[]
  empleados            EstacionEmpleado[]
  maquinas             Maquina[]
  reglas               EstacionRegla[]

  @@unique([tenantId, nombre])
  @@index([tenantId, activo])
}

/// Reglas de captura de una estación (rediseño "estaciones por reglas"): la
/// estación declara QUÉ agrupa; el paso no declara estación. La derivación
/// matchea el paso contra las reglas por prioridad (máquina > tecnología >
/// paso > familia). Convive con EstacionFamilia (regla "familia" legacy) y con
/// Maquina.estacionId (regla "máquina" legacy) como fallback.
/// Ver docs/estaciones-reglas-diseno.md.
model EstacionRegla {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  estacionId String   @db.Uuid
  /// 'maquina' | 'tecnologia' | 'paso' | 'familia'.
  tipo       String
  /// El valor a matchear: maquinaId | código de tecnología | familiaCodigo.
  valor      String
  createdAt  DateTime @default(now())
  estacion   Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)

  @@unique([estacionId, tipo, valor])
  @@index([tenantId, tipo, valor])
  @@index([tenantId, estacionId])
}

/// Umbrales configurables de las alertas del Panel (inteligencia de
/// negocio). Un registro por tenant, con defaults sensatos.
/// Ver docs/reportes-plan-backend.md §5.
model ConfiguracionInsights {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @db.Uuid
  /// Días sin comprar para marcar "dormido" a un cliente recurrente.
  diasClienteDormido  Int      @default(60)
  /// % de la facturación del período a partir del cual la deuda vencida alerta.
  deudaVencidaPctMax  Int      @default(20)
  /// % de facturación concentrada en el top-3 que alerta.
  concentracionPctMax Int      @default(50)
  /// Meses sin actualizar tarifas de un centro que alerta.
  mesesTarifaVieja    Int      @default(3)
  /// Razón real/cotizado (en %) por familia que alerta (150 = 1,5×).
  razonTiemposPctMax  Int      @default(150)
  /// % de utilización por centro por debajo del cual alerta.
  utilizacionPctMin   Int      @default(40)
  /// Margen % de categoría por debajo del cual alerta.
  margenPctMin        Int      @default(25)
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Gasto fijo de estructura (nivel empresa) — fuente ÚNICA del pool de costos
/// fijos del PUNTO DE EQUILIBRIO. Desacoplado de los centros de costo (que
/// existen para armar tarifas). Modelo recurrente con vigencia: aplica todos
/// los meses entre `vigenteDesde` y `vigenteHasta` (null = indefinido).
/// Ver docs/gastos-fijos-estructura-diseno.md
model GastoFijoEstructura {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  nombre         String
  /// Mismo catálogo que Cuentas por pagar, para que el gasto presupuestado y
  /// el pago real se clasifiquen igual. Sólo se ofrecen las de naturaleza
  /// GASTO_ESTRUCTURA: un gasto fijo de "materiales" no existe.
  categoriaEgresoId String           @db.Uuid
  /// Lo que el usuario carga: el valor de UNA cuota, con su frecuencia.
  valor          Decimal             @default(0) @db.Decimal(14, 2)
  frecuencia     FrecuenciaGastoFijo @default(MENSUAL)
  /// Derivado de valor y frecuencia, y persistido: es lo que suma el punto de
  /// equilibrio, y no tiene que depender de recalcular en cada lectura.
  importeMensual Decimal             @db.Decimal(14, 2)
  /// A quién se le paga — el "Favorecido" del listado. Opcional: no todo gasto
  /// de estructura tiene un proveedor cargado en el sistema.
  proveedorId    String?             @db.Uuid
  metodoPagoId   String?             @db.Uuid
  /// Número de factura, contrato o lo que identifique al gasto.
  documento      String?
  /// 'YYYY-MM' — primer mes de vigencia (inclusive).
  vigenteDesde   String
  /// 'YYYY-MM' — último mes de vigencia (inclusive); null = indefinido.
  vigenteHasta   String?
  activo         Boolean            @default(true)
  notas          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria      CategoriaEgreso     @relation(fields: [categoriaEgresoId], references: [id], onDelete: Restrict)
  proveedor      Proveedor?          @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  metodoPago     MetodoPago?         @relation(fields: [metodoPagoId], references: [id], onDelete: SetNull)
  egresos        Egreso[]
  recurrentes    GastoRecurrente[]

  @@index([tenantId])
  @@index([tenantId, proveedorId])
  @@index([tenantId, categoriaEgresoId])
}

/// Configuración de producción del tenant. Hoy: margen de seguridad que
/// el cotizador suma a la ETA cruda al sugerir la fecha prometible.
/// Ver docs/simulacion-flujo-diseno.md D13.
/// Cómo se presenta la imprenta ante su cliente: teléfono, web, dónde queda,
/// dónde dejar una reseña. Es lo COMERCIAL, y va aparte de `ConfiguracionFiscal`
/// a propósito: la razón social y el CUIT son lo que ARCA exige en un
/// comprobante, esto es lo que el cliente necesita para llamar, encontrar el
/// local o volver. Además son dos permisos distintos —`configuracion.gestionar`
/// del dueño contra `administracion.configurar` del administrativo— y en una
/// pantalla sola uno de los dos quedaba mal.
///
/// El nombre comercial NO está acá: sigue siendo `Tenant.nombre`, que ya lo
/// leen la sesión, el sidebar, el selector de empresa y el control plane. Un
/// segundo campo sólo abriría la puerta a que discrepen.
///
/// Ver docs/datos-de-empresa-diseno.md
model DatosEmpresa {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @db.Uuid
  /// Partido en tres columnas como el resto del sistema (ver
  /// `src/integraciones/telefono.ts`): lo que se muestra es el número tal cual
  /// se cargó, y para WhatsApp se normaliza a E.164 al vuelo.
  telefonoCodigo     String?
  telefonoNumero     String?
  paisCodigo         String?  @db.VarChar(2)
  /// Sólo si el WhatsApp del negocio es OTRO número que el teléfono. Null =
  /// es el mismo, que es el caso normal en una imprenta chica.
  whatsappCodigo     String?
  whatsappNumero     String?
  email              String?
  /// Con esquema (https://…). Se guarda normalizada para que el PDF no tenga
  /// que adivinar si "grafo.ar" es un link.
  sitioWeb           String?
  /// Dónde atiende, que no siempre es el domicilio fiscal: el fiscal puede ser
  /// el estudio contable y el cliente terminaría tocando un timbre equivocado.
  domicilioComercial String?
  localidad          String?
  provincia          String?
  /// "Lunes a viernes de 9 a 18" — texto libre a propósito: cada imprenta lo
  /// dice a su manera y una grilla de horarios sería un módulo entero.
  horarioAtencion    String?
  /// Link para dejar una reseña (Google, normalmente `https://g.page/r/…`).
  /// Es el dato que le falta a la plantilla de WhatsApp `grafo_resena_v2`, que
  /// está aprobada por Meta desde hace meses y no la manda nadie.
  urlResenas         String?
  /// URL del perfil de Google del negocio (ficha de Google Maps / Google
  /// Business, `https://maps.app.goo.gl/…` o `https://g.page/…`). Es a dónde
  /// apunta "Ver mapa" en el seguimiento público: si está cargada, se abre tal
  /// cual; si no, el front cae a buscar el domicilio en Google Maps.
  urlPerfilGoogle    String?
  /// ISO 4217 de la moneda en la que trabaja el negocio. Es ETIQUETA y
  /// formato, nunca conversión: cambiarla no reconvierte ningún monto
  /// histórico (multi-moneda-zona-horaria D1/D2). El catálogo con símbolo y
  /// decimales vive en código (`common/monedas.ts`).
  monedaCodigo       String   @default("ARS") @db.VarChar(3)
  /// Zona IANA del taller. Todo lo que piensa en "hora de pared" —calendario
  /// laboral, corte de jornada, ventana de WhatsApp, el "día" de un reporte—
  /// se evalúa en esta zona, no en la del server (que en Render es UTC).
  zonaHoraria        String   @default("America/Argentina/Buenos_Aires") @db.VarChar(64)
  /// Cómo redondea el PRICING: 'moneda' = los decimales de la moneda (2 en
  /// ARS, 0 en CLP); 'entero' = a la unidad, para los países donde los
  /// centavos existen en el papel pero no en la calle (ARS, COP).
  redondeoPrecio     String   @default("moneda") @db.VarChar(10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ConfiguracionProduccion {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @db.Uuid
  /// Días HÁBILES (L-V no feriado) de colchón sobre la ETA. 0 = sin margen.
  margenEtaDias       Int      @default(0)
  /// Hora local "HH:mm" de corte de jornada: los tramos de trabajo abiertos
  /// se cierran solos a esta hora (registro-tiempos-produccion D9).
  corteJornada        String   @default("20:00")
  /// Minutos entre pasos por defecto, para las estaciones que no declaran el
  /// suyo. Nadie termina 9:35 y arranca otro paso 9:35: hay que ir a buscar
  /// el material. 0 = sin colchón.
  tiempoEntrePasosMin Int      @default(0)
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Día en que el taller NO trabaja (feriado, vacaciones, cierre): fecha
/// puntual a nivel TENANT que la proyección de cola del tablero y la
/// simulación de flujo saltan. Ver docs/capacidad-estaciones-diseno.md D8.
model DiaNoLaborable {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  /// Fecha calendario local del taller (DATE, sin hora).
  fecha       DateTime @db.Date
  descripcion String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha])
  @@index([tenantId, fecha])
}

/// Familia de pasos asignada a una estación. Una familia puede estar en
/// varias estaciones SÓLO si tienen máquinas (filtran por máquina; son
/// disjuntas porque una máquina vive en una sola estación); a lo sumo una
/// estación general (sin máquinas) por familia — lo valida el service, el
/// paso siempre resuelve a UNA estación. Ver docs/estaciones-diseno.md D1.
model EstacionFamilia {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  estacionId    String   @db.Uuid
  /// FamiliaCodigo del catálogo fijo (productos-servicios/pasos/familias)
  /// O el UUID de un PasoTenant (instancia de plantilla): el ruteo a
  /// estaciones tiene una sola fuente de verdad y es esta tabla.
  familiaCodigo String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estacion      Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)

  @@unique([estacionId, familiaCodigo])
  @@index([tenantId, familiaCodigo])
  @@index([tenantId, estacionId])
}

/// E.1 (wizard de ruta, docs/wizard-ruta-diseno.md §2) — defaults declarados
/// del paso: la familia sugiere, el producto pisa, la cotización ajusta.
/// El motor los aplica como fallback VIVO al cotizar cuando la config del
/// producto dejó el campo vacío. `familiaCodigo` puede ser un código del
/// catálogo fijo O el UUID de un PasoTenant — mismo patrón que
/// EstacionFamilia: una sola tabla para ambos mundos.
model FamiliaPasoDefaults {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @db.Uuid
  familiaCodigo String
  /// Quién cobra el tiempo en pasos SIN máquina (con máquina lo trae ella).
  centroCostoId String? @db.Uuid
  /// Ritmo típico (unidades/hora) para T-2. La config del producto lo pisa.
  productividadHora Decimal? @db.Decimal(12, 2)
  /// Duración típica (min) para T-1 sin máquina.
  tiempoFijoMin Decimal? @db.Decimal(10, 2)
  /// Demasía por lado típica (mm) para pasos que nestean.
  demasiaMm Decimal? @db.Decimal(8, 2)
  /// Solape de panelizado típico (mm), gran formato sobre rollo.
  solapePanelMm Decimal? @db.Decimal(8, 2)

  /// E.2 — el paso lo hace un proveedor (bifurcación del wizard). true =
  /// las configs de producto nacen con el panel de tercerización prendido
  /// y precargado; el producto puede pisar (internalizar o cambiar
  /// proveedor). La GRILLA de precios sigue siendo por producto.
  tercerizado            Boolean?
  proveedorId            String?  @db.Uuid
  /// 'tarifa_magnitud' | 'matriz' | 'fijo'
  fuenteCostoTercerizado String?
  plazoProveedorDias     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centroCosto CentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: SetNull)
  proveedor   Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, familiaCodigo])
}

/// Familia de pasos creada por el TENANT (pasos componibles —
/// docs/pasos-componibles-diseno.md §8). Las 42 del sistema NO viven acá:
/// siguen en productos-servicios/pasos/familias.ts (decisión §8.1, híbrido).
/// En los `familiaCodigo` string del resto del schema viaja el UUID de esta
/// fila; el resolver distingue por forma (UUID → esta tabla, si no →
/// catálogo). La estación NO se duplica acá: el ruteo vive en
/// EstacionFamilia, que la API de familias escribe con familiaCodigo = id.
/// Paso propio del tenant: una INSTANCIA de una plantilla del catálogo del
/// sistema (docs/pasos-tenant-por-plantilla-diseno.md). NO declara su forma
/// —la hereda VIVA de `plantillaCodigo` en resolverFamilia— así que tiene
/// los mismos ejes que un paso de Grafo: derivador, nesting, primitivas.
/// Guarda sólo lo del taller: cómo se llama y sus defaults.
model PasoTenant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  /// FamiliaCodigo del catálogo del sistema del que hereda TODA la ficha.
  /// Es la herencia: cambiarlo re-apunta el paso a otra plantilla.
  plantillaCodigo String
  nombre          String
  descripcion     String?
  /// Ícono propio; si se omite vale el de la plantilla.
  icono           String?
  /// Inhabilitado: fuera de selectores, pero el resolver lo sigue
  /// resolviendo para rutas/OTs históricas.
  activo          Boolean @default(true)

  /// Defaults del taller (antes en FamiliaPasoDefaults, que sobrevive para
  /// las familias del sistema usadas sin instanciar). La instancia puede
  /// tener los suyos porque hay VARIAS instancias por plantilla.
  centroCostoId          String?  @db.Uuid
  productividadHora      Decimal? @db.Decimal(12, 2)
  tiempoFijoMin          Decimal? @db.Decimal(10, 2)
  demasiaMm              Decimal? @db.Decimal(8, 2)
  solapePanelMm          Decimal? @db.Decimal(8, 2)
  tercerizado            Boolean?
  proveedorId            String?  @db.Uuid
  /// 'tarifa_magnitud' | 'matriz' | 'fijo'
  fuenteCostoTercerizado String?
  plazoProveedorDias     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centroCosto CentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: SetNull)
  proveedor   Proveedor?   @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, nombre])
  @@index([tenantId, activo])
  @@index([tenantId, plantillaCodigo])
}

/// Empleado habilitado para trabajar en una estación (N:M).
model EstacionEmpleado {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  estacionId String   @db.Uuid
  empleadoId String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estacion   Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@unique([estacionId, empleadoId])
  @@index([tenantId, empleadoId])
}

model MateriaPrima {
  id                                       String                                    @id @default(uuid()) @db.Uuid
  tenantId                                 String                                    @db.Uuid
  materialPresetId                         String?                                   @db.Uuid
  codigo                                   String
  nombre                                   String
  descripcion                              String?
  canonicalMaterialKey                     String?
  canonicalMaterialName                    String?
  canonicalAliasUsado                      String?
  familia                                  FamiliaMateriaPrima
  subfamilia                               SubfamiliaMateriaPrima
  tipoTecnico                              String
  templateId                               String
  unidadStock                              UnidadMateriaPrima
  unidadCompra                             UnidadMateriaPrima
  esConsumible                             Boolean                                   @default(false)
  esRepuesto                               Boolean                                   @default(false)
  /**
   * true = artículo comprado para reventa/decoración (blank: taza, remera), no insumo de producción. Su costo entra por unidad (slot por_pieza). Ver docs/productos-comprados-merchandising-diseno.md
   */
  esProductoBase                           Boolean                                   @default(false)
  activo                                   Boolean                                   @default(true)
  atributosTecnicosJson                    Json
  createdAt                                DateTime                                  @default(now())
  updatedAt                                DateTime                                  @updatedAt
  tenant                                   Tenant                                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materialPreset                           MaterialPreset?                           @relation(fields: [materialPresetId], references: [id], onDelete: SetNull)
  variantes                                MateriaPrimaVariante[]
  productoConfigPasoSlotMaterialCandidatos ProductoConfigPasoSlotMaterialCandidato[]

  @@unique([tenantId, codigo])
  @@index([materialPresetId])
  @@index([tenantId, canonicalMaterialKey])
  @@index([tenantId, familia, subfamilia, activo])
  @@index([tenantId, nombre])
}

model MateriaPrimaVariante {
  id                             String                                            @id @default(uuid()) @db.Uuid
  tenantId                       String                                            @db.Uuid
  materiaPrimaId                 String                                            @db.Uuid
  materialPresetVarianteId       String?                                           @db.Uuid
  sku                            String
  nombreVariante                 String?
  activo                         Boolean                                           @default(true)
  atributosVarianteJson          Json
  unidadStock                    UnidadMateriaPrima?
  unidadCompra                   UnidadMateriaPrima?
  precioReferencia               Decimal?                                          @db.Decimal(14, 6)
  moneda                         String?                                           @db.VarChar(3)
  proveedorReferenciaId          String?                                           @db.Uuid
  createdAt                      DateTime                                          @default(now())
  updatedAt                      DateTime                                          @updatedAt
  tenant                         Tenant                                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materiaPrima                   MateriaPrima                                      @relation(fields: [materiaPrimaId], references: [id], onDelete: Cascade)
  materialPresetVariante         MaterialPresetVariante?                           @relation(fields: [materialPresetVarianteId], references: [id], onDelete: SetNull)
  proveedorReferencia            Proveedor?                                        @relation("MateriaPrimaVarianteProveedorReferencia", fields: [proveedorReferenciaId], references: [id], onDelete: SetNull)
  stocks                         StockMateriaPrimaVariante[]
  movimientosStock               MovimientoStockMateriaPrima[]
  maquinaConsumibles             MaquinaConsumible[]                               @relation("MaquinaConsumibleMateriaPrimaVariante")
  maquinaDesgastes               MaquinaComponenteDesgaste[]                       @relation("MaquinaDesgasteMateriaPrimaVariante")
  // === Modelo Universal V2 ===
  productoConfigPasoSlots        ProductoConfigPasoSlotMaterial[]                  @relation("ProductoConfigPasoSlotMaterialVariante")
  slotMaterialCandidatoDefaults  ProductoConfigPasoSlotMaterialCandidato[]         @relation("ProductoConfigPasoSlotMaterialCandidatoDefaultVariante")
  slotMaterialCandidatoVariantes ProductoConfigPasoSlotMaterialCandidatoVariante[]

  @@unique([tenantId, sku])
  @@index([materialPresetVarianteId])
  @@index([tenantId, materiaPrimaId, activo])
  @@index([tenantId, proveedorReferenciaId, activo])
}

model MaterialPreset {
  id                      String                   @id @default(uuid()) @db.Uuid
  key                     String                   @unique
  nombreCanonico          String
  descripcionCorta        String
  familia                 FamiliaMateriaPrima
  subfamilia              SubfamiliaMateriaPrima
  tipoTecnico             String
  templateId              String
  iconKind                String
  aliasDisponiblesJson    Json
  usosRecomendadosJson    Json
  procesosCompatiblesJson Json
  advertenciasJson        Json
