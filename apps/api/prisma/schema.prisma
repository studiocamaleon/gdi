model ProductoVarianteAlgoritmoConfig {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  productoVarianteId String           @db.Uuid
  algoritmoCostoId   String           @db.Uuid
  parametrosJson     Json
  versionConfig      Int              @default(1)
  activo             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoVariante   ProductoVariante @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  algoritmoCosto     AlgoritmoCosto   @relation(fields: [algoritmoCostoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productoVarianteId, algoritmoCostoId, versionConfig])
  @@index([tenantId, productoVarianteId, activo])
}

model CotizacionProductoSnapshot {
  id                    String                                 @id @default(uuid()) @db.Uuid
  tenantId              String                                 @db.Uuid
  productoServicioId    String?                                @db.Uuid
  productoVarianteId    String?                                @db.Uuid
  motorCodigo           String
  motorVersion          Int
  configVersionBase     Int?
  configVersionOverride Int?
  cantidad              Decimal                                @db.Decimal(14, 4)
  periodoTarifa         String
  inputJson             Json
  resultadoJson         Json
  total                 Decimal                                @db.Decimal(14, 6)
  createdAt             DateTime                               @default(now())
  tenant                Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productoServicio      ProductoServicio?                      @relation(fields: [productoServicioId], references: [id], onDelete: Cascade)
  productoVariante      ProductoVariante?                      @relation(fields: [productoVarianteId], references: [id], onDelete: Cascade)
  checklistRespuestas   CotizacionChecklistRespuestaSnapshot[]

  @@index([tenantId, productoServicioId, createdAt])
  @@index([tenantId, productoVarianteId, createdAt])
  @@index([tenantId, motorCodigo, motorVersion, createdAt])
