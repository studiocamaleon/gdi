model EmpleadoComision {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  empleadoId  String       @db.Uuid
  descripcion String
  tipo        TipoComision
  valor       Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
