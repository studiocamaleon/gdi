  updatedAt                   DateTime                               @updatedAt
  tenant                      Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pregunta                    ProductoChecklistPregunta              @relation(fields: [productoChecklistPreguntaId], references: [id], onDelete: Cascade)
  preguntaSiguiente           ProductoChecklistPregunta?             @relation("ChecklistPreguntaSiguiente", fields: [preguntaSiguienteId], references: [id], onDelete: SetNull)
