model Tenant {
  id                                               String                                            @id @default(uuid()) @db.Uuid
  nombre                                           String
  slug                                             String                                            @unique
  activo                                           Boolean                                           @default(true)
  createdAt                                        DateTime                                          @default(now())
  updatedAt                                        DateTime                                          @updatedAt
  memberships                                      Membership[]
  authSessions                                     AuthSession[]
  invitations                                      Invitation[]
  clientes                                         Cliente[]
  proveedores                                      Proveedor[]
  empleados                                        Empleado[]
  plantas                                          Planta[]
  areasCosto                                       AreaCosto[]
  centrosCosto                                     CentroCosto[]
  centroCostoRecursos                              CentroCostoRecurso[]
  centroCostoRecursosMaquinaria                    CentroCostoRecursoMaquinaPeriodo[]
  centroCostoComponentesCostoPeriodo               CentroCostoComponenteCostoPeriodo[]
  centroCostoCapacidadesPeriodo                    CentroCostoCapacidadPeriodo[]
  centroCostoTarifasPeriodo                        CentroCostoTarifaPeriodo[]
  maquinas                                         Maquina[]
  maquinaPerfilesOperativos                        MaquinaPerfilOperativo[]
  maquinaConsumibles                               MaquinaConsumible[]
  maquinaComponentesDesgaste                       MaquinaComponenteDesgaste[]
  materiasPrimas                                   MateriaPrima[]
  materiaPrimaVariantes                            MateriaPrimaVariante[]
  almacenesMateriaPrima                            AlmacenMateriaPrima[]
  almacenesMateriaPrimaUbicaciones                 AlmacenMateriaPrimaUbicacion[]
  stockMateriaPrimaVariantes                       StockMateriaPrimaVariante[]
  movimientoStockMateriaPrima                      MovimientoStockMateriaPrima[]
  clienteContactos                                 ClienteContacto[]
  clienteDireccions                                ClienteDireccion[]
  proveedorContactos                               ProveedorContacto[]
  proveedorDireccions                              ProveedorDireccion[]
  empleadoDireccions                               EmpleadoDireccion[]
  empleadoComisions                                EmpleadoComision[]
  productosImpuestosCatalogo                       ProductoImpuestoCatalogo[]
  productosComisionesCatalogo                      ProductoComisionCatalogo[]
  estaciones                                       Estacion[]
  // === Modelo Universal V2 (Fase F.1.2) ===
  rutas                                            Ruta[]
  rutaPasos                                        RutaPaso[]
  rutaVersiones                                    RutaVersion[]
  productos                                        Producto[]
  productoRutasAlternativas                        ProductoRutaAlternativa[]
  productoConfigPasos                              ProductoConfigPaso[]
  productoConfigPasoSlotsMateriales                ProductoConfigPasoSlotMaterial[]
  productoConfigPasoSlotMaterialCandidatos         ProductoConfigPasoSlotMaterialCandidato[]
  productoConfigPasoSlotMaterialCandidatoVariantes ProductoConfigPasoSlotMaterialCandidatoVariante[]
  productoConfigPasoMaquinasCandidatas             ProductoConfigPasoMaquinaCandidata[]
  productoPasosExtras                              ProductoPasoExtra[]
  cargosDirectosCatalogo                           CargoDirectoCatalogo[]
  productoCargosDirectosPaso                       ProductoCargoDirectoPaso[]
  productoCargosDirectosCotizacion                 ProductoCargoDirectoCotizacion[]
  cotizacionesV2                                   Cotizacion[]
  cotizacionesV2Items                              CotizacionItem[]
  productosPreciosEspecialesClientesV2             ProductoPrecioEspecialClienteV2[]
  productosImpuestosAplicados                      ProductoImpuestoAplicado[]
  productosComisionesAplicadas                     ProductoComisionAplicada[]
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  passwordHash   String?
  nombreCompleto String?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  memberships    Membership[]
  authSessions   AuthSession[]
  invitations    Invitation[]
  empleados      Empleado[]
}

model Membership {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  tenantId        String        @db.Uuid
  rol             RolSistema
  activa          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authSessions    AuthSession[]
  invitationsSent Invitation[]  @relation("InvitationSender")

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model AuthSession {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @db.Uuid
  currentTenantId     String     @db.Uuid
  currentMembershipId String     @db.Uuid
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTenant       Tenant     @relation(fields: [currentTenantId], references: [id], onDelete: Cascade)
  currentMembership   Membership @relation(fields: [currentMembershipId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([currentTenantId])
}

model Invitation {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @db.Uuid
  userId                String?    @db.Uuid
  empleadoId            String?    @db.Uuid
  invitedByMembershipId String     @db.Uuid
  email                 String
  rol                   RolSistema
  tokenHash             String     @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  empleado              Empleado?  @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  invitedByMembership   Membership @relation("InvitationSender", fields: [invitedByMembershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([empleadoId])
}

model Cliente {
  id                  String                            @id @default(uuid()) @db.Uuid
  tenantId            String                            @db.Uuid
  nombre              String
  razonSocial         String?
  emailPrincipal      String
  telefonoCodigo      String
  telefonoNumero      String
  paisCodigo          String                            @db.VarChar(2)
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  tenant              Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactos           ClienteContacto[]
  direcciones         ClienteDireccion[]
  // === Modelo Universal V2 ===
  cotizacionesV2      Cotizacion[]                      @relation("CotizacionV2Cliente")
  preciosEspecialesV2 ProductoPrecioEspecialClienteV2[] @relation("ProductoPrecioEspecialClienteV2Cliente")

  @@unique([tenantId, nombre])
  @@index([tenantId, nombre])
}

model Proveedor {
  id                              String                 @id @default(uuid()) @db.Uuid
  tenantId                        String                 @db.Uuid
  nombre                          String
  razonSocial                     String?
  emailPrincipal                  String
  telefonoCodigo                  String
  telefonoNumero                  String
  paisCodigo                      String                 @db.VarChar(2)
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  tenant                          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactos                       ProveedorContacto[]
  direcciones                     ProveedorDireccion[]
  materiaPrimaVariantesReferencia MateriaPrimaVariante[] @relation("MateriaPrimaVarianteProveedorReferencia")

  @@unique([tenantId, nombre])
  @@index([tenantId, nombre])
}

model Empleado {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @db.Uuid
  userId                String?              @db.Uuid
  nombreCompleto        String
  emailPrincipal        String
  telefonoCodigo        String
  telefonoNumero        String
  sector                String
  ocupacion             String?
  sexo                  SexoEmpleado?
  fechaIngreso          DateTime             @db.Date
  fechaNacimiento       DateTime?            @db.Date
  comisionesHabilitadas Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  direcciones           EmpleadoDireccion[]
  comisiones            EmpleadoComision[]
  centrosACargo         CentroCosto[]        @relation("CentroCostoResponsable")
  invitations           Invitation[]
  recursosCentroCosto   CentroCostoRecurso[] @relation("CentroCostoRecursoEmpleado")

  @@index([tenantId, nombreCompleto])
  @@index([tenantId, sector])
}

model ClienteContacto {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  clienteId      String   @db.Uuid
  nombre         String
  cargo          String?
  email          String?
  telefonoCodigo String?
  telefonoNumero String?
  principal      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([tenantId, clienteId])
}

model ClienteDireccion {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  clienteId    String        @db.Uuid
  descripcion  String
  paisCodigo   String        @db.VarChar(2)
  codigoPostal String?
  direccion    String
  numero       String?
  ciudad       String
  tipo         TipoDireccion
  principal    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente      Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([tenantId, clienteId])
}

model ProveedorContacto {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  proveedorId    String    @db.Uuid
  nombre         String
  cargo          String?
  email          String?
  telefonoCodigo String?
  telefonoNumero String?
  principal      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([tenantId, proveedorId])
}

model ProveedorDireccion {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  proveedorId  String        @db.Uuid
  descripcion  String
  paisCodigo   String        @db.VarChar(2)
  codigoPostal String?
  direccion    String
  numero       String?
  ciudad       String
  tipo         TipoDireccion
  principal    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proveedor    Proveedor     @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@index([tenantId, proveedorId])
}

model EmpleadoDireccion {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  empleadoId   String        @db.Uuid
  descripcion  String
  paisCodigo   String        @db.VarChar(2)
  codigoPostal String?
  direccion    String
  numero       String?
  ciudad       String
  tipo         TipoDireccion
  principal    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleado     Empleado      @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([tenantId, empleadoId])
}

model EmpleadoComision {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  empleadoId  String       @db.Uuid
  descripcion String
  tipo        TipoComision
  valor       Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleado    Empleado     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([tenantId, empleadoId])
}

model Planta {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  codigo       String
  nombre       String
  descripcion  String?
  activa       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  areasCosto   AreaCosto[]
  centrosCosto CentroCosto[]
  maquinas     Maquina[]

  @@unique([tenantId, codigo])
  @@index([tenantId, nombre])
}

model AreaCosto {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  plantaId     String        @db.Uuid
  codigo       String
  nombre       String
  descripcion  String?
  activa       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planta       Planta        @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  centrosCosto CentroCosto[]

  @@unique([tenantId, plantaId, codigo])
  @@index([tenantId, plantaId, nombre])
}

model CentroCosto {
  id                      String                              @id @default(uuid()) @db.Uuid
  tenantId                String                              @db.Uuid
  plantaId                String                              @db.Uuid
  areaCostoId             String                              @db.Uuid
  codigo                  String
  nombre                  String
  descripcion             String?
  tipoCentro              TipoCentroCosto
  categoriaGrafica        CategoriaGraficaCentroCosto
  imputacionPreferida     ImputacionPreferidaCentroCosto
  unidadBaseFutura        UnidadBaseCentroCosto               @default(NINGUNA)
  responsableEmpleadoId   String?                             @db.Uuid
  activo                  Boolean                             @default(true)
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  tenant                  Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planta                  Planta                              @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  areaCosto               AreaCosto                           @relation(fields: [areaCostoId], references: [id], onDelete: Cascade)
  responsableEmpleado     Empleado?                           @relation("CentroCostoResponsable", fields: [responsableEmpleadoId], references: [id], onDelete: SetNull)
  recursos                CentroCostoRecurso[]
  componentesCostoPeriodo CentroCostoComponenteCostoPeriodo[]
  capacidadesPeriodo      CentroCostoCapacidadPeriodo[]
  tarifasPeriodo          CentroCostoTarifaPeriodo[]
  maquinasPrincipales     Maquina[]                           @relation("MaquinaCentroCostoPrincipal")
  productoConfigPasos     ProductoConfigPaso[]                @relation("ProductoConfigPasoCentroCostoManual")
  productoPasosExtras     ProductoPasoExtra[]                 @relation("ProductoPasoExtraCentroCostoManual")

  @@unique([tenantId, codigo])
  @@index([tenantId, plantaId, areaCostoId])
  @@index([tenantId, nombre])
}

model CentroCostoRecurso {
  id                      String                             @id @default(uuid()) @db.Uuid
  tenantId                String                             @db.Uuid
  centroCostoId           String                             @db.Uuid
  periodo                 String
  tipoRecurso             TipoRecursoCentroCosto
  empleadoId              String?                            @db.Uuid
  maquinaId               String?                            @db.Uuid
  nombreRecurso           String?
  tipoGastoGeneral        TipoGastoGeneralCentroCosto?
