/// Perfil operativo de una máquina. Modelo universal alineado a doc §5–§13:
/// - Universales (columnas): productividad, setup, cleanup, feedReload, tipo.
/// - Discriminantes específicos por plantilla: en `detalleJson` (JSON libre).
///
/// v3.0 (2026-04-26): eliminadas 10 columnas legacy del modelo viejo
/// (printMode, printSides, cantidadPasadas, dobleFaz, materialPreset,
/// sheetThicknessMm, maxBatchHeightMm, operationMode, anchoAplicable,
/// altoAplicable). Ahora todas viven en `detalleJson` con las claves que la
/// plantilla declare.
model MaquinaPerfilOperativo {
  id                                  String                               @id @default(uuid()) @db.Uuid
  tenantId                            String                               @db.Uuid
  maquinaId                           String                               @db.Uuid
  nombre                              String
  tipoPerfil                          TipoPerfilOperativoMaquina
  activo                              Boolean                              @default(true)
  productivityValue                   Decimal?                             @db.Decimal(12, 2)
  productivityUnit                    UnidadProduccionMaquina?
  setupMin                            Decimal?                             @db.Decimal(12, 2)
  cleanupMin                          Decimal?                             @db.Decimal(12, 2)
  feedReloadMin                       Decimal?                             @db.Decimal(12, 2)
  /// Discriminantes y params específicos de la plantilla.
  /// Ej. IMPRESORA_LASER: { caras: 'SIMPLE_FAZ' | 'DOBLE_FAZ',
  ///   colores: 'BN' | 'CMYK', gramajeMinGr, gramajeMaxGr }
  /// Ej. GUILLOTINA: { gramajeMinGr, gramajeMaxGr, pliegosMaxPorTanda }
  /// Ej. PLOTTER_DE_CORTE: { tipoCorte: 'COMPLETO' | 'KISS_CUT',
  ///   modoOperacion: 'ROLLO' | 'HOJAS',
  ///   factorComplejidad: 'simple' | 'intermedio' | 'complejo' | 'personalizado' }
  detalleJson                         Json?
  /// Regla declarativa JsonLogic para auto-selección por el motor (G-M8).
  reglaSeleccionJson                  Json?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  tenant                              Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maquina                             Maquina                              @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  consumibles                         MaquinaConsumible[]
  // === Modelo Universal V2 ===
  productoConfigPasosM1               ProductoConfigPaso[]                 @relation("ProductoConfigPasoPerfilM1")
  productoPasosExtrasM1               ProductoPasoExtra[]                  @relation("ProductoPasoExtraPerfilM1")
  productoConfigPasoCandidatasDefault ProductoConfigPasoMaquinaCandidata[] @relation("ProductoConfigPasoMaquinaCandidataPerfilDefault")

  @@unique([tenantId, maquinaId, nombre])
  @@index([tenantId, maquinaId, activo])
}

