# Copiar a .env y completar. NUNCA commitear .env (está en .gitignore).

PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://usuario:clave@localhost:5432/gdi_saas?schema=public
JWT_SECRET=

# ── Workers y colas ─────────────────────────────────────────────────────
# La API web no requiere Redis mientras ningún flujo productivo use la cola.
# Para levantar el worker local: docker compose up -d redis
REDIS_URL=redis://127.0.0.1:6379
WORKER_GEOMETRY_CONCURRENCY=1
# Cola separada: un cálculo grande nunca queda delante de uno interactivo.
WORKER_GEOMETRY_HEAVY_CONCURRENCY=1
# Orquestaciones de cotización en espera de geometría/DB; no ejecutan Python.
WORKER_QUOTE_CONCURRENCY=4
# Equidad entre empresas aun cuando haya varias réplicas de workers.
WORKER_TENANT_GEOMETRY_CONCURRENCY=1
WORKER_TENANT_QUOTE_CONCURRENCY=2
WORKER_REDIS_CONNECT_TIMEOUT_MS=5000
WORKER_REDIS_READY_TIMEOUT_MS=10000
# Python del entorno aislado que contiene compas_nest.
OPENNEST_PYTHON=python3
# Límite absoluto aunque un job solicite más tiempo.
OPENNEST_TIMEOUT_MAX_MS=60000
# Presupuesto solicitado por el análisis productivo antes de la validación.
OPENNEST_JOB_TIMEOUT_MS=30000
# Máximo que una cotización espera un job (incluye tiempo en cola).
OPENNEST_QUOTE_WAIT_TIMEOUT_MS=900000
# Resultado validado compartido entre réplicas (7 días por defecto).
GRAFONEST_CACHE_TTL_SECONDS=604800
# Sólo hace falta si el runner no fue copiado junto al build.
# OPENNEST_RUNNER_PATH=/ruta/opennest_runner.py

# ── Alta pública y correo transaccional (Resend) ─────────────────────────
# En local, sin API key, el enlace se escribe en el log del API. En producción
# el API no arranca con el registro habilitado si falta la clave.
REGISTRO_PUBLICO_HABILITADO=true
REGISTRO_PUBLICO_URL=http://localhost:3000
TERMINOS_VERSION=2026-08-27
RESEND_API_KEY=
# Debe pertenecer a un dominio verificado en Resend.
RESEND_FROM=Grafoprint <registro@grafoprint.com.ar>
RESEND_REPLY_TO=soporte@grafoprint.com.ar

# ── Facturación electrónica (etapa D) ────────────────────────────────────
# AFIP SDK: https://afipsdk.com — el token es de GRAFO, no de cada tenant.
# El modelo es delegación de webservices de ARCA: un certificado de Grafo
# representa a N CUITs, y cada request elige el representado por CUIT.
# Ver docs/modulo-administracion-diseno.md
AFIPSDK_ACCESS_TOKEN=
# dev | prod — 'dev' pega contra homologación de ARCA (sin validez fiscal).
AFIPSDK_ENVIRONMENT=dev
# CUIT de demo de AFIP SDK: el único que emite en homologación sin
# certificado. Sólo aplica con AFIPSDK_ENVIRONMENT=dev; en prod se ignora
# y se emite con el CUIT del tenant.
AFIPSDK_DEV_CUIT=20409378472
# Certificado de Grafo como Computador Fiscal (producción). No van acá en
# claro: en producción salen del secrets manager.
AFIPSDK_CERT=
AFIPSDK_KEY=
# CUIT de Grafo (el que los tenants delegan en ARCA), 11 dígitos.
GRAFO_CUIT=

# ── Almacenamiento de archivos (Cloudflare R2) ──────────────────────────
# Sin estas variables el API usa el driver LOCAL (apps/api/.storage/), que
# alcanza para desarrollar; en producción el arranque falla si faltan, para
# no guardar los archivos de los clientes en el disco efímero del contenedor.
# El bucket tiene que ser PRIVADO y aceptar PUT por CORS desde FRONTEND_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grafo-archivos
# Opcional: por defecto https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Tope por archivo en bytes (default 2 GB — con multipart ya no lo limita el
# tamaño de un request).
ARCHIVOS_MAX_BYTES=2147483648
# Sólo para el driver local: base de las URLs firmadas que ve el navegador.
API_PUBLIC_URL=http://localhost:3001

# ── Integraciones con terceros ──────────────────────────────────────────
# Clave AES-256 (32 bytes) para cifrar en reposo las credenciales de
# terceros. Generar con:  openssl rand -base64 32
# En producción el arranque FALLA si falta: sin clave no se pueden guardar
# ni leer credenciales, y arrancar igual sólo posterga el problema.
# NUNCA guardarla en la base — si viven juntas, cifrar no protege de nada.
INTEGRACIONES_ENCRYPTION_KEY=

# ── Cobro de suscripciones · Paddle ─────────────────────────────────────
# Cómo la PLATAFORMA le cobra a los tenants (no confundir con la
# integración ARCA/AFIP, que es para que el tenant facture a SUS clientes).
# Se sacan del dashboard de Paddle. Sin API key el cobro queda deshabilitado
# y el resto del sistema sigue funcionando; sin el secret, el webhook
# responde 503 en vez de procesar eventos sin poder verificar quién los manda.
# Ver docs/suscripciones-cobro-diseno.md
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Developer Tools → Notifications → el secret de la destination del webhook.
PADDLE_WEBHOOK_SECRET=
